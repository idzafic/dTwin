ODEs:

	// --- G8 ---
	Eq_p_g8' = (-Eq_p_g8 - (Xd_g8 - Xd_p_g8)*Id_g8 + Efd_g8)/Tdo_p_g8
	Ed_p_g8' = (-Ed_p_g8 + (Xq_g8 - Xq_p_g8)*Iq_g8)/Tqo_p_g8
	δ_g8'    = (ω_g8 - ω_ref) * ω_s
	ω_g8'    = (P_gml_8 - (Ed_p_g8 * Id_g8 + Eq_p_g8 * Iq_g8 + (Xq_p_g8 - Xd_p_g8) * Id_g8 * Iq_g8) - D_g8*(ω_g8 - ω_ref)) * ω_s /(2*H_g8)
	Efd_g8'  = (-(Ke_g8 + Se_g8)*Efd_g8 + VR_g8)/Te_g8
	Rf_g8'   = (-Rf_g8 + (Kf_g8/Tf_g8)*Efd_g8)/Tf_g8
	VR_g8'   = (-VR_g8 + Ka_g8*Rf_g8 - (Ka_g8*Kf_g8/Tf_g8)*Efd_g8 + Ka_g8*(Vref_g8 - V_8))/Ta_g8
	P_gmr_8' = (ω_ref - ω_g8) / (T_gov_g8 * R_g8 * ω_ref)

	// --- G10 ---
	Eq_p_g10' = (-Eq_p_g10 - (Xd_g10 - Xd_p_g10)*Id_g10 + Efd_g10)/Tdo_p_g10
