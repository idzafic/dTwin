	@main.P_5_g = P_5_init

	@main.δ_1 = δ_1; @main.V_1 = V_1
	@main.δ_2 = δ_2; @main.V_2 = V_2
	@main.δ_3 = δ_3; @main.V_3 = V_3
	@main.δ_4 = δ_4_init; @main.V_4 = V_4_init
	@main.δ_5 = δ_5; @main.V_5 = V_5
end
ODEs:

	// --- G1 ---
	Eq_p_g1' = (-Eq_p_g1 - (Xd_g1 - Xd_p_g1)*Id_g1 + Efd_g1)/Tdo_p_g1
	Ed_p_g1' = (-Ed_p_g1 + (Xq_g1 - Xq_p_g1)*Iq_g1)/Tqo_p_g1
	δ_g1'    = (ω_g1 - ω_ref) * ω_s
	ω_g1'    = (P_gml_1 - (Ed_p_g1 * Id_g1 + Eq_p_g1 * Iq_g1 + (Xq_p_g1 - Xd_p_g1) * Id_g1 * Iq_g1) - D_g1*(ω_g1 - ω_ref)) * ω_s /(2*H_g1)
	Efd_g1'  = (-(Ke_g1 + Se_g1)*Efd_g1 + VR_g1)/Te_g1
	Rf_g1'   = (-Rf_g1 + (Kf_g1/Tf_g1)*Efd_g1)/Tf_g1
	VR_g1'   = (-VR_g1 + Ka_g1*Rf_g1 - (Ka_g1*Kf_g1/Tf_g1)*Efd_g1 + Ka_g1*(Vref_g1 - V_1))/Ta_g1
	P_gmr_1' = (ω_ref - ω_g1) / (T_gov_g1 * R_g1 * ω_ref)

	// --- G3 ---
	Eq_p_g3' = (-Eq_p_g3 - (Xd_g3 - Xd_p_g3)*Id_g3 + Efd_g3)/Tdo_p_g3
	Ed_p_g3' = (-Ed_p_g3 + (Xq_g3 - Xq_p_g3)*Iq_g3)/Tqo_p_g3
	δ_g3'    = (ω_g3 - ω_ref) * ω_s
	ω_g3'    = (P_gml_3 - (Ed_p_g3 * Id_g3 + Eq_p_g3 * Iq_g3 + (Xq_p_g3 - Xd_p_g3) * Id_g3 * Iq_g3) - D_g3*(ω_g3 - ω_ref)) * ω_s /(2*H_g3)
	Efd_g3'  = (-(Ke_g3 + Se_g3)*Efd_g3 + VR_g3)/Te_g3
	Rf_g3'   = (-Rf_g3 + (Kf_g3/Tf_g3)*Efd_g3)/Tf_g3
	VR_g3'   = (-VR_g3 + Ka_g3*Rf_g3 - (Ka_g3*Kf_g3/Tf_g3)*Efd_g3 + Ka_g3*(Vref_g3 - V_3))/Ta_g3
	P_gmr_3' = (ω_ref - ω_g3) / (T_gov_g3 * R_g3 * ω_ref)

	// --- G4 ---
	Eq_p_g4' = (-Eq_p_g4 - (Xd_g4 - Xd_p_g4)*Id_g4 + Efd_g4)/Tdo_p_g4
	Ed_p_g4' = (-Ed_p_g4 + (Xq_g4 - Xq_p_g4)*Iq_g4)/Tqo_p_g4
	δ_g4'    = (ω_g4 - ω_ref) * ω_s
	ω_g4'    = (P_gml_4 - (Ed_p_g4 * Id_g4 + Eq_p_g4 * Iq_g4 + (Xq_p_g4 - Xd_p_g4) * Id_g4 * Iq_g4) - D_g4*(ω_g4 - ω_ref)) * ω_s /(2*H_g4)
	Efd_g4'  = (-(Ke_g4 + Se_g4)*Efd_g4 + VR_g4)/Te_g4
	Rf_g4'   = (-Rf_g4 + (Kf_g4/Tf_g4)*Efd_g4)/Tf_g4
	VR_g4'   = (-VR_g4 + Ka_g4*Rf_g4 - (Ka_g4*Kf_g4/Tf_g4)*Efd_g4 + Ka_g4*(Vref_g4 - V_4))/Ta_g4
	P_gmr_4' = (ω_ref - ω_g4) / (T_gov_g4 * R_g4 * ω_ref)

	// --- G5 ---
	Eq_p_g5' = (-Eq_p_g5 - (Xd_g5 - Xd_p_g5)*Id_g5 + Efd_g5)/Tdo_p_g5
	Ed_p_g5' = (-Ed_p_g5 + (Xq_g5 - Xq_p_g5)*Iq_g5)/Tqo_p_g5
	δ_g5'    = (ω_g5 - ω_ref) * ω_s
	ω_g5'    = (P_gml_5 - (Ed_p_g5 * Id_g5 + Eq_p_g5 * Iq_g5 + (Xq_p_g5 - Xd_p_g5) * Id_g5 * Iq_g5) - D_g5*(ω_g5 - ω_ref)) * ω_s /(2*H_g5)
	Efd_g5'  = (-(Ke_g5 + Se_g5)*Efd_g5 + VR_g5)/Te_g5
	Rf_g5'   = (-Rf_g5 + (Kf_g5/Tf_g5)*Efd_g5)/Tf_g5
	VR_g5'   = (-VR_g5 + Ka_g5*Rf_g5 - (Ka_g5*Kf_g5/Tf_g5)*Efd_g5 + Ka_g5*(Vref_g5 - V_5))/Ta_g5
	P_gmr_5' = (ω_ref - ω_g5) / (T_gov_g5 * R_g5 * ω_ref)
NLEs:
	// Stator algebraic equations
	Id_g1 = (Rs_g1 * (Ed_p_g1 - V_1 * sin(δ_g1 - δ_1)) + Xq_p_g1 * (Eq_p_g1 - V_1 * cos(δ_g1 - δ_1))) / (Rs_g1^2 + Xd_p_g1 * Xq_p_g1)
	Iq_g1 = (-Xd_p_g1 * (Ed_p_g1 - V_1 * sin(δ_g1 - δ_1)) + Rs_g1 * (Eq_p_g1 - V_1 * cos(δ_g1 - δ_1))) / (Rs_g1^2 + Xd_p_g1 * Xq_p_g1)
	P_gml_1=lim(P_gmr_1, 0.0, 0.8)
	Id_g3 = (Rs_g3 * (Ed_p_g3 - V_3 * sin(δ_g3 - δ_3)) + Xq_p_g3 * (Eq_p_g3 - V_3 * cos(δ_g3 - δ_3))) / (Rs_g3^2 + Xd_p_g3 * Xq_p_g3)
	Iq_g3 = (-Xd_p_g3 * (Ed_p_g3 - V_3 * sin(δ_g3 - δ_3)) + Rs_g3 * (Eq_p_g3 - V_3 * cos(δ_g3 - δ_3))) / (Rs_g3^2 + Xd_p_g3 * Xq_p_g3)
	P_gml_3=lim(P_gmr_3, 0.0, 3.4)
	Id_g4 = (Rs_g4 * (Ed_p_g4 - V_4 * sin(δ_g4 - δ_4)) + Xq_p_g4 * (Eq_p_g4 - V_4 * cos(δ_g4 - δ_4))) / (Rs_g4^2 + Xd_p_g4 * Xq_p_g4)
	Iq_g4 = (-Xd_p_g4 * (Ed_p_g4 - V_4 * sin(δ_g4 - δ_4)) + Rs_g4 * (Eq_p_g4 - V_4 * cos(δ_g4 - δ_4))) / (Rs_g4^2 + Xd_p_g4 * Xq_p_g4)
	P_gml_4=lim(P_gmr_4, 0.0, 10.4)
	Id_g5 = (Rs_g5 * (Ed_p_g5 - V_5 * sin(δ_g5 - δ_5)) + Xq_p_g5 * (Eq_p_g5 - V_5 * cos(δ_g5 - δ_5))) / (Rs_g5^2 + Xd_p_g5 * Xq_p_g5)
	Iq_g5 = (-Xd_p_g5 * (Ed_p_g5 - V_5 * sin(δ_g5 - δ_5)) + Rs_g5 * (Eq_p_g5 - V_5 * cos(δ_g5 - δ_5))) / (Rs_g5^2 + Xd_p_g5 * Xq_p_g5)
	P_gml_5=lim(P_gmr_5, 0.0, 4.0)

	// Elec. power
	Pe_g1 = Ed_p_g1 * Id_g1 + Eq_p_g1 * Iq_g1 + (Xq_p_g1 - Xd_p_g1) * Id_g1 * Iq_g1
	Pe_g3 = Ed_p_g3 * Id_g3 + Eq_p_g3 * Iq_g3 + (Xq_p_g3 - Xd_p_g3) * Id_g3 * Iq_g3
	Pe_g4 = Ed_p_g4 * Id_g4 + Eq_p_g4 * Iq_g4 + (Xq_p_g4 - Xd_p_g4) * Id_g4 * Iq_g4
	Pe_g5 = Ed_p_g5 * Id_g5 + Eq_p_g5 * Iq_g5 + (Xq_p_g5 - Xd_p_g5) * Id_g5 * Iq_g5

	// PF for PV
	// node 1 - PV
	V_1 * (Id_g1*sin(δ_g1 - δ_1) + Iq_g1*cos(δ_g1 - δ_1)) =	Y_1_1*V_1^2*cos(θ_1_1) + V_1 * (Y_1_2*V_2*cos(δ_1-θ_1_2-δ_2) + Y_1_4*V_4*cos(δ_1-θ_1_4-δ_4) + Y_1_5*V_5*cos(δ_1-θ_1_5-δ_5))
	V_1 * (Id_g1*cos(δ_g1 - δ_1) - Iq_g1*sin(δ_g1 - δ_1)) =	-Y_1_1*V_1^2*sin(θ_1_1) + V_1 * (Y_1_2*V_2*sin(δ_1-θ_1_2-δ_2) + Y_1_4*V_4*sin(δ_1-θ_1_4-δ_4) + Y_1_5*V_5*sin(δ_1-θ_1_5-δ_5))
	// node 3 - PV
	V_3 * (Id_g3*sin(δ_g3 - δ_3) + Iq_g3*cos(δ_g3 - δ_3)) - P_3_l=	Y_3_3*V_3^2*cos(θ_3_3) + V_3 * (Y_3_2*V_2*cos(δ_3-θ_3_2-δ_2) + Y_3_4*V_4*cos(δ_3-θ_3_4-δ_4))
	V_3 * (Id_g3*cos(δ_g3 - δ_3) - Iq_g3*sin(δ_g3 - δ_3)) - Q_3_l=	-Y_3_3*V_3^2*sin(θ_3_3) + V_3 * (Y_3_2*V_2*sin(δ_3-θ_3_2-δ_2) + Y_3_4*V_4*sin(δ_3-θ_3_4-δ_4))
	// node 4 - PV
	V_4 * (Id_g4*sin(δ_g4 - δ_4) + Iq_g4*cos(δ_g4 - δ_4)) - P_4_l=	Y_4_4*V_4^2*cos(θ_4_4) + V_4 * (Y_4_1*V_1*cos(δ_4-θ_4_1-δ_1) + Y_4_3*V_3*cos(δ_4-θ_4_3-δ_3) + Y_4_5*V_5*cos(δ_4-θ_4_5-δ_5))
	V_4 * (Id_g4*cos(δ_g4 - δ_4) - Iq_g4*sin(δ_g4 - δ_4)) - Q_4_l=	-Y_4_4*V_4^2*sin(θ_4_4) + V_4 * (Y_4_1*V_1*sin(δ_4-θ_4_1-δ_1) + Y_4_3*V_3*sin(δ_4-θ_4_3-δ_3) + Y_4_5*V_5*sin(δ_4-θ_4_5-δ_5))
	// node 5 - PV
	V_5 * (Id_g5*sin(δ_g5 - δ_5) + Iq_g5*cos(δ_g5 - δ_5)) =	Y_5_5*V_5^2*cos(θ_5_5) + V_5 * (Y_5_1*V_1*cos(δ_5-θ_5_1-δ_1) + Y_5_4*V_4*cos(δ_5-θ_5_4-δ_4))
	V_5 * (Id_g5*cos(δ_g5 - δ_5) - Iq_g5*sin(δ_g5 - δ_5)) =	-Y_5_5*V_5^2*sin(θ_5_5) + V_5 * (Y_5_1*V_1*sin(δ_5-θ_5_1-δ_1) + Y_5_4*V_4*sin(δ_5-θ_5_4-δ_4))

	// PF for PQ
	// node 2 - PQ
	Y_2_2*V_2^2*cos(θ_2_2) + V_2 * (Y_2_1*V_1*cos(δ_2-θ_2_1-δ_1) + Y_2_3*V_3*cos(δ_2-θ_2_3-δ_3)) = P_2
	-Y_2_2*V_2^2*sin(θ_2_2) + V_2 * (Y_2_1*V_1*sin(δ_2-θ_2_1-δ_1) + Y_2_3*V_3*sin(δ_2-θ_2_3-δ_3)) = Q_2

	PostProc: 	//Simulate on/off or max PQ load
		if t >= 0.5:
			if t < 6:
				P_2 = 0 	//off between 0.5 and 6 sec
				Q_2 = 0
			else:
				P_2 = -3.0 	//on again after 6 sec
				Q_2 = -0.9861
			end
		end
end
