	// --- G1 ---
	Eq_p_g1' = (-Eq_p_g1 - (Xd_g1 - Xd_p_g1)*Id_g1 + Efd_g1)/Tdo_p_g1
	Ed_p_g1' = (-Ed_p_g1 + (Xq_g1 - Xq_p_g1)*Iq_g1)/Tqo_p_g1
	δ_g1'    = (ω_g1 - ω_ref) * ω_s
	ω_g1'    = (P_gmr_1 - (Ed_p_g1 * Id_g1 + Eq_p_g1 * Iq_g1 + (Xq_p_g1 - Xd_p_g1) * Id_g1 * Iq_g1) - D_g1*(ω_g1 - ω_ref)) * ω_s /(2*H_g1)
	Efd_g1'  = (-(Ke_g1 + Se_g1)*Efd_g1 + VR_g1)/Te_g1
	Rf_g1'   = (-Rf_g1 + (Kf_g1/Tf_g1)*Efd_g1)/Tf_g1
	VR_g1'   = (-VR_g1 + Ka_g1*Rf_g1 - (Ka_g1*Kf_g1/Tf_g1)*Efd_g1 + Ka_g1*(Vref_g1 - V_1))/Ta_g1
	P_gmr_1' = (ω_ref - ω_g1) / (T_gov_g1 * R_g1 * ω_ref)

	// --- G4 ---
	Eq_p_g4' = (-Eq_p_g4 - (Xd_g4 - Xd_p_g4)*Id_g4 + Efd_g4)/Tdo_p_g4
	Ed_p_g4' = (-Ed_p_g4 + (Xq_g4 - Xq_p_g4)*Iq_g4)/Tqo_p_g4
	δ_g4'    = (ω_g4 - ω_ref) * ω_s
	ω_g4'    = (P_gmr_4 - (Ed_p_g4 * Id_g4 + Eq_p_g4 * Iq_g4 + (Xq_p_g4 - Xd_p_g4) * Id_g4 * Iq_g4) - D_g4*(ω_g4 - ω_ref)) * ω_s /(2*H_g4)
	Efd_g4'  = (-(Ke_g4 + Se_g4)*Efd_g4 + VR_g4)/Te_g4
	Rf_g4'   = (-Rf_g4 + (Kf_g4/Tf_g4)*Efd_g4)/Tf_g4
	VR_g4'   = (-VR_g4 + Ka_g4*Rf_g4 - (Ka_g4*Kf_g4/Tf_g4)*Efd_g4 + Ka_g4*(Vref_g4 - V_4))/Ta_g4
	P_gmr_4' = (ω_ref - ω_g4) / (T_gov_g4 * R_g4 * ω_ref)

	// --- G6 ---
	Eq_p_g6' = (-Eq_p_g6 - (Xd_g6 - Xd_p_g6)*Id_g6 + Efd_g6)/Tdo_p_g6
	Ed_p_g6' = (-Ed_p_g6 + (Xq_g6 - Xq_p_g6)*Iq_g6)/Tqo_p_g6
	δ_g6'    = (ω_g6 - ω_ref) * ω_s
	ω_g6'    = (P_gmr_6 - (Ed_p_g6 * Id_g6 + Eq_p_g6 * Iq_g6 + (Xq_p_g6 - Xd_p_g6) * Id_g6 * Iq_g6) - D_g6*(ω_g6 - ω_ref)) * ω_s /(2*H_g6)
	Efd_g6'  = (-(Ke_g6 + Se_g6)*Efd_g6 + VR_g6)/Te_g6
	Rf_g6'   = (-Rf_g6 + (Kf_g6/Tf_g6)*Efd_g6)/Tf_g6
	VR_g6'   = (-VR_g6 + Ka_g6*Rf_g6 - (Ka_g6*Kf_g6/Tf_g6)*Efd_g6 + Ka_g6*(Vref_g6 - V_6))/Ta_g6
	P_gmr_6' = (ω_ref - ω_g6) / (T_gov_g6 * R_g6 * ω_ref)

	// --- G8 ---
	Eq_p_g8' = (-Eq_p_g8 - (Xd_g8 - Xd_p_g8)*Id_g8 + Efd_g8)/Tdo_p_g8
	Ed_p_g8' = (-Ed_p_g8 + (Xq_g8 - Xq_p_g8)*Iq_g8)/Tqo_p_g8
	δ_g8'    = (ω_g8 - ω_ref) * ω_s
	ω_g8'    = (P_gmr_8 - (Ed_p_g8 * Id_g8 + Eq_p_g8 * Iq_g8 + (Xq_p_g8 - Xd_p_g8) * Id_g8 * Iq_g8) - D_g8*(ω_g8 - ω_ref)) * ω_s /(2*H_g8)
	Efd_g8'  = (-(Ke_g8 + Se_g8)*Efd_g8 + VR_g8)/Te_g8
	Rf_g8'   = (-Rf_g8 + (Kf_g8/Tf_g8)*Efd_g8)/Tf_g8
	VR_g8'   = (-VR_g8 + Ka_g8*Rf_g8 - (Ka_g8*Kf_g8/Tf_g8)*Efd_g8 + Ka_g8*(Vref_g8 - V_8))/Ta_g8
	P_gmr_8' = (ω_ref - ω_g8) / (T_gov_g8 * R_g8 * ω_ref)

	// --- G10 ---
	Eq_p_g10' = (-Eq_p_g10 - (Xd_g10 - Xd_p_g10)*Id_g10 + Efd_g10)/Tdo_p_g10
