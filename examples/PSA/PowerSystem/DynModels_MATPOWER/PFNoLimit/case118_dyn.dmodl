	Y_94_94*V_94^2*cos(θ_94_94) + V_94 * (Y_94_100*V_100*cos(δ_94-θ_94_100-δ_100) + Y_94_92*V_92*cos(δ_94-θ_94_92-δ_92) + Y_94_93*V_93*cos(δ_94-θ_94_93-δ_93) + Y_94_95*V_95*cos(δ_94-θ_94_95-δ_95) + Y_94_96*V_96*cos(δ_94-θ_94_96-δ_96)) = P_94
	-Y_94_94*V_94^2*sin(θ_94_94) + V_94 * (Y_94_100*V_100*sin(δ_94-θ_94_100-δ_100) + Y_94_92*V_92*sin(δ_94-θ_94_92-δ_92) + Y_94_93*V_93*sin(δ_94-θ_94_93-δ_93) + Y_94_95*V_95*sin(δ_94-θ_94_95-δ_95) + Y_94_96*V_96*sin(δ_94-θ_94_96-δ_96)) = Q_94
	// node 95 - PQ
	Y_95_95*V_95^2*cos(θ_95_95) + V_95 * (Y_95_94*V_94*cos(δ_95-θ_95_94-δ_94) + Y_95_96*V_96*cos(δ_95-θ_95_96-δ_96)) = P_95
	-Y_95_95*V_95^2*sin(θ_95_95) + V_95 * (Y_95_94*V_94*sin(δ_95-θ_95_94-δ_94) + Y_95_96*V_96*sin(δ_95-θ_95_96-δ_96)) = Q_95
	// node 96 - PQ
	Y_96_96*V_96^2*cos(θ_96_96) + V_96 * (Y_96_97*V_97*cos(δ_96-θ_96_97-δ_97) + Y_96_80*V_80*cos(δ_96-θ_96_80-δ_80) + Y_96_82*V_82*cos(δ_96-θ_96_82-δ_82) + Y_96_94*V_94*cos(δ_96-θ_96_94-δ_94) + Y_96_95*V_95*cos(δ_96-θ_96_95-δ_95)) = P_96
	-Y_96_96*V_96^2*sin(θ_96_96) + V_96 * (Y_96_97*V_97*sin(δ_96-θ_96_97-δ_97) + Y_96_80*V_80*sin(δ_96-θ_96_80-δ_80) + Y_96_82*V_82*sin(δ_96-θ_96_82-δ_82) + Y_96_94*V_94*sin(δ_96-θ_96_94-δ_94) + Y_96_95*V_95*sin(δ_96-θ_96_95-δ_95)) = Q_96
	// node 97 - PQ
	Y_97_97*V_97^2*cos(θ_97_97) + V_97 * (Y_97_96*V_96*cos(δ_97-θ_97_96-δ_96) + Y_97_80*V_80*cos(δ_97-θ_97_80-δ_80)) = P_97
	-Y_97_97*V_97^2*sin(θ_97_97) + V_97 * (Y_97_96*V_96*sin(δ_97-θ_97_96-δ_96) + Y_97_80*V_80*sin(δ_97-θ_97_80-δ_80)) = Q_97
	// node 98 - PQ
	Y_98_98*V_98^2*cos(θ_98_98) + V_98 * (Y_98_100*V_100*cos(δ_98-θ_98_100-δ_100) + Y_98_80*V_80*cos(δ_98-θ_98_80-δ_80)) = P_98
	-Y_98_98*V_98^2*sin(θ_98_98) + V_98 * (Y_98_100*V_100*sin(δ_98-θ_98_100-δ_100) + Y_98_80*V_80*sin(δ_98-θ_98_80-δ_80)) = Q_98
	// node 101 - PQ
	Y_101_101*V_101^2*cos(θ_101_101) + V_101 * (Y_101_100*V_100*cos(δ_101-θ_101_100-δ_100) + Y_101_102*V_102*cos(δ_101-θ_101_102-δ_102)) = P_101
	-Y_101_101*V_101^2*sin(θ_101_101) + V_101 * (Y_101_100*V_100*sin(δ_101-θ_101_100-δ_100) + Y_101_102*V_102*sin(δ_101-θ_101_102-δ_102)) = Q_101
	// node 102 - PQ
	Y_102_102*V_102^2*cos(θ_102_102) + V_102 * (Y_102_92*V_92*cos(δ_102-θ_102_92-δ_92) + Y_102_101*V_101*cos(δ_102-θ_102_101-δ_101)) = P_102
	-Y_102_102*V_102^2*sin(θ_102_102) + V_102 * (Y_102_92*V_92*sin(δ_102-θ_102_92-δ_92) + Y_102_101*V_101*sin(δ_102-θ_102_101-δ_101)) = Q_102
	// node 106 - PQ
	Y_106_106*V_106^2*cos(θ_106_106) + V_106 * (Y_106_105*V_105*cos(δ_106-θ_106_105-δ_105) + Y_106_107*V_107*cos(δ_106-θ_106_107-δ_107) + Y_106_100*V_100*cos(δ_106-θ_106_100-δ_100)) = P_106
	-Y_106_106*V_106^2*sin(θ_106_106) + V_106 * (Y_106_105*V_105*sin(δ_106-θ_106_105-δ_105) + Y_106_107*V_107*sin(δ_106-θ_106_107-δ_107) + Y_106_100*V_100*sin(δ_106-θ_106_100-δ_100)) = Q_106
	// node 108 - PQ
	Y_108_108*V_108^2*cos(θ_108_108) + V_108 * (Y_108_105*V_105*cos(δ_108-θ_108_105-δ_105) + Y_108_109*V_109*cos(δ_108-θ_108_109-δ_109)) = P_108
	-Y_108_108*V_108^2*sin(θ_108_108) + V_108 * (Y_108_105*V_105*sin(δ_108-θ_108_105-δ_105) + Y_108_109*V_109*sin(δ_108-θ_108_109-δ_109)) = Q_108
	// node 109 - PQ
	Y_109_109*V_109^2*cos(θ_109_109) + V_109 * (Y_109_108*V_108*cos(δ_109-θ_109_108-δ_108) + Y_109_110*V_110*cos(δ_109-θ_109_110-δ_110)) = P_109
	-Y_109_109*V_109^2*sin(θ_109_109) + V_109 * (Y_109_108*V_108*sin(δ_109-θ_109_108-δ_108) + Y_109_110*V_110*sin(δ_109-θ_109_110-δ_110)) = Q_109
	// node 114 - PQ
	Y_114_114*V_114^2*cos(θ_114_114) + V_114 * (Y_114_115*V_115*cos(δ_114-θ_114_115-δ_115) + Y_114_32*V_32*cos(δ_114-θ_114_32-δ_32)) = P_114
	-Y_114_114*V_114^2*sin(θ_114_114) + V_114 * (Y_114_115*V_115*sin(δ_114-θ_114_115-δ_115) + Y_114_32*V_32*sin(δ_114-θ_114_32-δ_32)) = Q_114
	// node 115 - PQ
	Y_115_115*V_115^2*cos(θ_115_115) + V_115 * (Y_115_114*V_114*cos(δ_115-θ_115_114-δ_114) + Y_115_27*V_27*cos(δ_115-θ_115_27-δ_27)) = P_115
	-Y_115_115*V_115^2*sin(θ_115_115) + V_115 * (Y_115_114*V_114*sin(δ_115-θ_115_114-δ_114) + Y_115_27*V_27*sin(δ_115-θ_115_27-δ_27)) = Q_115
	// node 117 - PQ
	Y_117_117*V_117^2*cos(θ_117_117) + V_117 * (Y_117_12*V_12*cos(δ_117-θ_117_12-δ_12)) = P_117
	-Y_117_117*V_117^2*sin(θ_117_117) + V_117 * (Y_117_12*V_12*sin(δ_117-θ_117_12-δ_12)) = Q_117
	// node 118 - PQ
	Y_118_118*V_118^2*cos(θ_118_118) + V_118 * (Y_118_75*V_75*cos(δ_118-θ_118_75-δ_75) + Y_118_76*V_76*cos(δ_118-θ_118_76-δ_76)) = P_118
	-Y_118_118*V_118^2*sin(θ_118_118) + V_118 * (Y_118_75*V_75*sin(δ_118-θ_118_75-δ_75) + Y_118_76*V_76*sin(δ_118-θ_118_76-δ_76)) = Q_118

	PostProc: 	//Simulate on/off or max PQ load
		if t >= 0.5:
			if t < 6:
				P_60 = 0 	//off between 0.5 and 6 sec
				Q_60 = 0
			else:
				P_60 = -0.78 	//on again after 6 sec
				Q_60 = -0.03
			end
		end
end
