Header:
	newTab = false
end
Model [name="Visual of Dynamics"]:
Plots:
	linePlot [xLabel="Time [s]" yLabel="Speed [p.u.]" name="Gen. speeds"]:
		@x << t
		@y << ω_g913 [colorL=black colorD=white width=2 pattern="solid" name="ω_g913"]
		@y << ω_g2107 [colorL=darkRed colorD=magenta width=2 pattern="solid" name="ω_g2107"]
		@y << ω_g2267 [colorL=darkBlue colorD=cyan width=2 pattern="solid" name="ω_g2267"]
		@y << ω_g3659 [colorL=darkGreen colorD=yellow width=2 pattern="solid" name="ω_g3659"]
		@y << ω_g4586 [colorL=purple colorD=orange width=2 pattern="solid" name="ω_g4586"]
		@y << ω_g5097 [colorL=saddleBrown colorD=lime width=2 pattern="solid" name="ω_g5097"]
		@y << ω_g6233 [colorL=indigo colorD=lightBlue width=2 pattern="solid" name="ω_g6233"]
		@y << ω_g6798 [colorL=darkMagenta colorD=hotPink width=2 pattern="solid" name="ω_g6798"]
		@y << ω_g7279 [colorL=maroon colorD=gold width=2 pattern="solid" name="ω_g7279"]
		@y << ω_g7960 [colorL=navy colorD=violet width=2 pattern="solid" name="ω_g7960"]
		@y << ω_g8605 [colorL=forestGreen colorD=aqua width=2 pattern="solid" name="ω_g8605"]
		@y << ω_g9239 [colorL=royalBlue colorD=coral width=2 pattern="solid" name="ω_g9239"]
		@y << ω_ref [colorL=black colorD=white width=1 pattern="dot" name="Ref. ω"]
	end

	linePlot [xLabel="Time [s]" yLabel="Power [p.u.]" name="Gen. Powers"]:
