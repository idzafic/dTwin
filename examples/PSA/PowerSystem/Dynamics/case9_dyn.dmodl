Params:
	// Gen 1 initials
	P_1_init; Q_1_init
	I_r1_init; I_i1_init; Eq_r1_init; Eq_i1_init
	I_d1_init; I_q1_init; V_d1_init; V_q1_init 
	E_d1_p_init; E_q1_p_init; Tm1_init; Vt_g1_init
	Ef_d1_init; VR1_init; Rf1_init; Vref1_init
	// Gen 2 initials
	P_2_init; Q_2_init
