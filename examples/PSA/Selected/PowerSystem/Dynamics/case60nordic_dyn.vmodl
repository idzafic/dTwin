			@y << Pe_g55 [colorD=blue width=2 pattern="dot" name="Elec. Power g55"]
			@y << Pe_g56 [colorD=red width=2 pattern="dot" name="Elec. Power g56"]
			@y << Pe_g57 [colorD=green width=2 pattern="dot" name="Elec. Power g57"]
			@y << Pe_g58 [colorD=cyan width=2 pattern="dot" name="Elec. Power g58"]
			@y << Pe_g59 [colorD=orange width=2 pattern="dot" name="Elec. Power g59"]
			@y << Pe_g60 [colorD=magenta width=2 pattern="dot" name="Elec. Power g60"]
			end

		linePlot [xLabel="Time [s]" yLabel="Angle [rad]" name="Rotor Angles"]:
			@x << t
			@y << δ_g38 [colorD=red width=2 name="Angle δ_g38"]
			@y << δ_g39 [colorD=green width=2 name="Angle δ_g39"]
