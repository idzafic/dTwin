			@y << δ_g59 [colorD=orange width=2 name="Angle δ_g59"]
			@y << δ_g60 [colorD=magenta width=2 name="Angle δ_g60"]
			end

		linePlot [xLabel="Time [s]" yLabel="Voltage [p.u.]" name="Generator Terminal Voltages"]:
			@x << t
			@y << V_38 [colorD=orange width=2 name="Terminal Vt_g38 (Bus 38)"]
