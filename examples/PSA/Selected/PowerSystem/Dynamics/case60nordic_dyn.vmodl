			@y << Pe_g48 [colorD=magenta width=2 pattern="dot" name="Elec. Power g48"]
			@y << Pe_g49 [colorD=blue width=2 pattern="dot" name="Elec. Power g49"]
			@y << Pe_g50 [colorD=red width=2 pattern="dot" name="Elec. Power g50"]
