			@y << P_gm_g60 [colorD=magenta width=2 name="Mech. Power g60"]
			@y << Pe_g38 [colorD=red width=2 pattern="dot" name="Elec. Power g38"]
			@y << Pe_g39 [colorD=green width=2 pattern="dot" name="Elec. Power g39"]
