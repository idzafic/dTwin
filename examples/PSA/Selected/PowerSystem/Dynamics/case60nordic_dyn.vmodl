Header:
	newTab = false
end
Model [name="Visual of Dynamics"]:
	Plots:
		linePlot [xLabel="Time [s]" yLabel="Speed [p.u.]" name="Frequency Dynamics"]:
			@x << t
			@y << ω_g38 [colorD=orange width=2 name="Speed ω_g38"]
			@y << ω_g39 [colorD=magenta width=2 name="Speed ω_g39"]
			@y << ω_g40 [colorD=blue width=2 name="Speed ω_g40"]
			@y << ω_g41 [colorD=red width=2 name="Speed ω_g41"]
			@y << ω_g42 [colorD=green width=2 name="Speed ω_g42"]
			@y << ω_g43 [colorD=cyan width=2 name="Speed ω_g43"]
			@y << ω_g44 [colorD=orange width=2 name="Speed ω_g44"]
			@y << ω_g45 [colorD=magenta width=2 name="Speed ω_g45"]
			@y << ω_g46 [colorD=blue width=2 name="Speed ω_g46"]
			@y << ω_g47 [colorD=red width=2 name="Speed ω_g47"]
			@y << ω_g48 [colorD=green width=2 name="Speed ω_g48"]
			@y << ω_g49 [colorD=cyan width=2 name="Speed ω_g49"]
			@y << ω_g50 [colorD=orange width=2 name="Speed ω_g50"]
			@y << ω_g51 [colorD=magenta width=2 name="Speed ω_g51"]
			@y << ω_g52 [colorD=blue width=2 name="Speed ω_g52"]
			@y << ω_g53 [colorD=red width=2 name="Speed ω_g53"]
			@y << ω_g54 [colorD=green width=2 name="Speed ω_g54"]
			@y << ω_g55 [colorD=cyan width=2 name="Speed ω_g55"]
			@y << ω_g56 [colorD=orange width=2 name="Speed ω_g56"]
			@y << ω_g57 [colorD=magenta width=2 name="Speed ω_g57"]
			@y << ω_g58 [colorD=blue width=2 name="Speed ω_g58"]
			@y << ω_g59 [colorD=red width=2 name="Speed ω_g59"]
			@y << ω_g60 [colorD=green width=2 name="Speed ω_g60"]
			@y << ω_ref [colorD=white width=1 pattern="dot" name="Reference ω"]
			end

		linePlot [xLabel="Time [s]" yLabel="Power [p.u.]" name="Governor Power Output"]:
			@x << t
			@y << P_gm_g38 [colorD=red width=2 name="Mech. Power g38"]
			@y << P_gm_g39 [colorD=green width=2 name="Mech. Power g39"]
			@y << P_gm_g40 [colorD=cyan width=2 name="Mech. Power g40"]
			@y << P_gm_g41 [colorD=orange width=2 name="Mech. Power g41"]
			@y << P_gm_g42 [colorD=magenta width=2 name="Mech. Power g42"]
			@y << P_gm_g43 [colorD=blue width=2 name="Mech. Power g43"]
			@y << P_gm_g44 [colorD=red width=2 name="Mech. Power g44"]
			@y << P_gm_g45 [colorD=green width=2 name="Mech. Power g45"]
			@y << P_gm_g46 [colorD=cyan width=2 name="Mech. Power g46"]
