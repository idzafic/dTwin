			@y << V_111 [colorD=magenta width=2 name="Terminal Vt_g111 (Bus 111)"]
			@y << V_112 [colorD=blue width=2 name="Terminal Vt_g112 (Bus 112)"]
			@y << V_113 [colorD=red width=2 name="Terminal Vt_g113 (Bus 113)"]
			@y << V_116 [colorD=orange width=2 name="Terminal Vt_g116 (Bus 116)"]
			end

end
