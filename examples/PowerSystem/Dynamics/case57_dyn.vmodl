Header:
	newTab = false
end
Model [name="Visual of Dynamics"]:
	Plots:
		linePlot [xLabel="Time [s]" yLabel="Speed [p.u.]" name="Frequency Dynamics"]:
			@x << t
			@y << ω_g1 [colorD=cyan width=2 name="Speed ω_g1"]
			@y << ω_g2 [colorD=orange width=2 name="Speed ω_g2"]
			@y << ω_g3 [colorD=magenta width=2 name="Speed ω_g3"]
			@y << ω_g6 [colorD=green width=2 name="Speed ω_g6"]
			@y << ω_g8 [colorD=orange width=2 name="Speed ω_g8"]
			@y << ω_g9 [colorD=magenta width=2 name="Speed ω_g9"]
			@y << ω_g12 [colorD=green width=2 name="Speed ω_g12"]
			@y << ω_ref [colorD=white width=1 pattern="dot" name="Reference ω"]
			end

		linePlot [xLabel="Time [s]" yLabel="Power [p.u.]" name="Governor Power Output"]:
			@x << t
			@y << P_gm_g1 [colorD=blue width=2 name="Mech. Power g1"]
			@y << P_gm_g2 [colorD=red width=2 name="Mech. Power g2"]
			@y << P_gm_g3 [colorD=green width=2 name="Mech. Power g3"]
			@y << P_gm_g6 [colorD=magenta width=2 name="Mech. Power g6"]
			@y << P_gm_g8 [colorD=red width=2 name="Mech. Power g8"]
			@y << P_gm_g9 [colorD=green width=2 name="Mech. Power g9"]
			@y << P_gm_g12 [colorD=magenta width=2 name="Mech. Power g12"]
			@y << Pe_g1 [colorD=blue width=2 pattern="dot" name="Elec. Power g1"]
			@y << Pe_g2 [colorD=red width=2 pattern="dot" name="Elec. Power g2"]
			@y << Pe_g3 [colorD=green width=2 pattern="dot" name="Elec. Power g3"]
			@y << Pe_g6 [colorD=magenta width=2 pattern="dot" name="Elec. Power g6"]
			@y << Pe_g8 [colorD=red width=2 pattern="dot" name="Elec. Power g8"]
			@y << Pe_g9 [colorD=green width=2 pattern="dot" name="Elec. Power g9"]
			@y << Pe_g12 [colorD=magenta width=2 pattern="dot" name="Elec. Power g12"]
			end

		linePlot [xLabel="Time [s]" yLabel="Angle [rad]" name="Rotor Angles"]:
			@x << t
			@y << δ_g1 [colorD=blue width=2 name="Angle δ_g1"]
			@y << δ_g2 [colorD=red width=2 name="Angle δ_g2"]
			@y << δ_g3 [colorD=green width=2 name="Angle δ_g3"]
			@y << δ_g6 [colorD=magenta width=2 name="Angle δ_g6"]
			@y << δ_g8 [colorD=red width=2 name="Angle δ_g8"]
			@y << δ_g9 [colorD=green width=2 name="Angle δ_g9"]
			@y << δ_g12 [colorD=magenta width=2 name="Angle δ_g12"]
			end

		linePlot [xLabel="Time [s]" yLabel="Voltage [p.u.]" name="Generator Terminal Voltages"]:
			@x << t
			@y << V_1 [colorD=cyan width=2 name="Terminal Vt_g1 (Bus 1)"]
			@y << V_2 [colorD=orange width=2 name="Terminal Vt_g2 (Bus 2)"]
			@y << V_3 [colorD=magenta width=2 name="Terminal Vt_g3 (Bus 3)"]
			@y << V_6 [colorD=green width=2 name="Terminal Vt_g6 (Bus 6)"]
			@y << V_8 [colorD=orange width=2 name="Terminal Vt_g8 (Bus 8)"]
			@y << V_9 [colorD=magenta width=2 name="Terminal Vt_g9 (Bus 9)"]
			@y << V_12 [colorD=green width=2 name="Terminal Vt_g12 (Bus 12)"]
			end

end
