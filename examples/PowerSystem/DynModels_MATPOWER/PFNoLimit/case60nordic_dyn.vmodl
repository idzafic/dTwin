Header:
	newTab = false
end
Model [name="Visual of Dynamics"]:
Plots:
	linePlot [xLabel="Time [s]" yLabel="Speed [p.u.]" name="Gen. speeds"]:
		@x << t
		@y << ω_g38 [colorL=black colorD=white width=2 pattern="solid" name="ω_g38"]
		@y << ω_g39 [colorL=darkRed colorD=magenta width=2 pattern="solid" name="ω_g39"]
		@y << ω_g40 [colorL=darkBlue colorD=cyan width=2 pattern="solid" name="ω_g40"]
		@y << ω_g41 [colorL=darkGreen colorD=yellow width=2 pattern="solid" name="ω_g41"]
		@y << ω_g42 [colorL=purple colorD=orange width=2 pattern="solid" name="ω_g42"]
		@y << ω_g43 [colorL=saddleBrown colorD=lime width=2 pattern="solid" name="ω_g43"]
		@y << ω_g44 [colorL=indigo colorD=lightBlue width=2 pattern="solid" name="ω_g44"]
		@y << ω_g45 [colorL=darkMagenta colorD=hotPink width=2 pattern="solid" name="ω_g45"]
		@y << ω_g46 [colorL=maroon colorD=gold width=2 pattern="solid" name="ω_g46"]
		@y << ω_g47 [colorL=navy colorD=violet width=2 pattern="solid" name="ω_g47"]
		@y << ω_g48 [colorL=forestGreen colorD=aqua width=2 pattern="solid" name="ω_g48"]
		@y << ω_g49 [colorL=royalBlue colorD=coral width=2 pattern="solid" name="ω_g49"]
		@y << ω_g50 [colorL=eggplant colorD=springGreen width=2 pattern="solid" name="ω_g50"]
		@y << ω_g51 [colorL=olive colorD=dodgerBlue width=2 pattern="solid" name="ω_g51"]
		@y << ω_g52 [colorL=crimson colorD=pink width=2 pattern="solid" name="ω_g52"]
		@y << ω_g53 [colorL=midnightBlue colorD=turquoise width=2 pattern="solid" name="ω_g53"]
		@y << ω_g54 [colorL=seaGreen colorD=lightGreen width=2 pattern="solid" name="ω_g54"]
		@y << ω_g55 [colorL=firebrick colorD=orchid width=2 pattern="solid" name="ω_g55"]
		@y << ω_g56 [colorL=pine colorD=deepSkyBlue width=2 pattern="solid" name="ω_g56"]
		@y << ω_g57 [colorL=mulberry colorD=salmon width=2 pattern="solid" name="ω_g57"]
		@y << ω_g58 [colorL=oliveDrab colorD=mediumSpringGreen width=2 pattern="solid" name="ω_g58"]
		@y << ω_g59 [colorL=sienna colorD=plum width=2 pattern="solid" name="ω_g59"]
		@y << ω_g60 [colorL=chocolate colorD=skyBlue width=2 pattern="solid" name="ω_g60"]
		@y << ω_ref [colorL=black colorD=white width=1 pattern="dot" name="Ref. ω"]
	end

	linePlot [xLabel="Time [s]" yLabel="Power [p.u.]" name="Gen. Powers"]:
