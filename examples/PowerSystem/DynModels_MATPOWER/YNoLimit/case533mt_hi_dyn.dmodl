	PostProc: 	//Simulate on/off or max PQ load
		if t >= 0.5:
			if t < 6:
				Y_72_72 = Y_72_72_fault 	//off between 0.5 and 6 sec
				θ_72_72 = θ_72_72_fault
			else:
				Y_72_72 = Y_72_72_reg 	//on again after 6 sec
