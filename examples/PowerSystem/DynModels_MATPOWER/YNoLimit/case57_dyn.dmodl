	Tm12_init = @main.Ed_p_g12*I_d12_init + @main.Eq_p_g12*I_q12_init + (Xq_p_g12 - Xd_p_g12)*I_d12_init*I_q12_init;
	@main.Pe_g12 = Tm12_init;
	@main.P_gmr_12 = Tm12_init;
	@main.Tm_g12 = Tm12_init;
	@main.Q_12_g = Q_12_init
	@main.P_12_g = P_12_init

