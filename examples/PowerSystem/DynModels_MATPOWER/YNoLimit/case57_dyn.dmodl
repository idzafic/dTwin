	Vref12_init = V_12 + (VR12_init / Ka_g12)
	@main.ω_g12 = ω_ref
	@main.Ed_p_g12 = E_d12_p_init
	@main.Eq_p_g12 = E_q12_p_init
	@main.VR_g12 = VR12_init
	@main.Rf_g12 = Rf12_init
