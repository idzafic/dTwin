ODEs:

	// --- G1 ---
	Eq_p_g1' = (-Eq_p_g1 - (Xd_g1 - Xd_p_g1)*Id_g1 + Efd_g1)/Tdo_p_g1
	Ed_p_g1' = (-Ed_p_g1 + (Xq_g1 - Xq_p_g1)*Iq_g1)/Tqo_p_g1
	δ_g1'    = (ω_g1 - ω_ref) * ω_s
	ω_g1'    = (P_gmr_1 - (Ed_p_g1 * Id_g1 + Eq_p_g1 * Iq_g1 + (Xq_p_g1 - Xd_p_g1) * Id_g1 * Iq_g1) - D_g1*(ω_g1 - ω_ref)) * ω_s /(2*H_g1)
	Efd_g1'  = (-(Ke_g1 + Se_g1)*Efd_g1 + VR_g1)/Te_g1
	Rf_g1'   = (-Rf_g1 + (Kf_g1/Tf_g1)*Efd_g1)/Tf_g1
	VR_g1'   = (-VR_g1 + Ka_g1*Rf_g1 - (Ka_g1*Kf_g1/Tf_g1)*Efd_g1 + Ka_g1*(Vref_g1 - V_1))/Ta_g1
	P_gmr_1' = (ω_ref - ω_g1) / (T_gov_g1 * R_g1 * ω_ref)

	// --- G2 ---
	Eq_p_g2' = (-Eq_p_g2 - (Xd_g2 - Xd_p_g2)*Id_g2 + Efd_g2)/Tdo_p_g2
	Ed_p_g2' = (-Ed_p_g2 + (Xq_g2 - Xq_p_g2)*Iq_g2)/Tqo_p_g2
	δ_g2'    = (ω_g2 - ω_ref) * ω_s
	ω_g2'    = (P_gmr_2 - (Ed_p_g2 * Id_g2 + Eq_p_g2 * Iq_g2 + (Xq_p_g2 - Xd_p_g2) * Id_g2 * Iq_g2) - D_g2*(ω_g2 - ω_ref)) * ω_s /(2*H_g2)
	Efd_g2'  = (-(Ke_g2 + Se_g2)*Efd_g2 + VR_g2)/Te_g2
	Rf_g2'   = (-Rf_g2 + (Kf_g2/Tf_g2)*Efd_g2)/Tf_g2
	VR_g2'   = (-VR_g2 + Ka_g2*Rf_g2 - (Ka_g2*Kf_g2/Tf_g2)*Efd_g2 + Ka_g2*(Vref_g2 - V_2))/Ta_g2
	P_gmr_2' = (ω_ref - ω_g2) / (T_gov_g2 * R_g2 * ω_ref)

	// --- G3 ---
	Eq_p_g3' = (-Eq_p_g3 - (Xd_g3 - Xd_p_g3)*Id_g3 + Efd_g3)/Tdo_p_g3
	Ed_p_g3' = (-Ed_p_g3 + (Xq_g3 - Xq_p_g3)*Iq_g3)/Tqo_p_g3
	δ_g3'    = (ω_g3 - ω_ref) * ω_s
	ω_g3'    = (P_gmr_3 - (Ed_p_g3 * Id_g3 + Eq_p_g3 * Iq_g3 + (Xq_p_g3 - Xd_p_g3) * Id_g3 * Iq_g3) - D_g3*(ω_g3 - ω_ref)) * ω_s /(2*H_g3)
	Efd_g3'  = (-(Ke_g3 + Se_g3)*Efd_g3 + VR_g3)/Te_g3
	Rf_g3'   = (-Rf_g3 + (Kf_g3/Tf_g3)*Efd_g3)/Tf_g3
	VR_g3'   = (-VR_g3 + Ka_g3*Rf_g3 - (Ka_g3*Kf_g3/Tf_g3)*Efd_g3 + Ka_g3*(Vref_g3 - V_3))/Ta_g3
	P_gmr_3' = (ω_ref - ω_g3) / (T_gov_g3 * R_g3 * ω_ref)

	// --- G6 ---
	Eq_p_g6' = (-Eq_p_g6 - (Xd_g6 - Xd_p_g6)*Id_g6 + Efd_g6)/Tdo_p_g6
	Ed_p_g6' = (-Ed_p_g6 + (Xq_g6 - Xq_p_g6)*Iq_g6)/Tqo_p_g6
	δ_g6'    = (ω_g6 - ω_ref) * ω_s
	ω_g6'    = (P_gmr_6 - (Ed_p_g6 * Id_g6 + Eq_p_g6 * Iq_g6 + (Xq_p_g6 - Xd_p_g6) * Id_g6 * Iq_g6) - D_g6*(ω_g6 - ω_ref)) * ω_s /(2*H_g6)
	Efd_g6'  = (-(Ke_g6 + Se_g6)*Efd_g6 + VR_g6)/Te_g6
	Rf_g6'   = (-Rf_g6 + (Kf_g6/Tf_g6)*Efd_g6)/Tf_g6
	VR_g6'   = (-VR_g6 + Ka_g6*Rf_g6 - (Ka_g6*Kf_g6/Tf_g6)*Efd_g6 + Ka_g6*(Vref_g6 - V_6))/Ta_g6
	P_gmr_6' = (ω_ref - ω_g6) / (T_gov_g6 * R_g6 * ω_ref)

	// --- G8 ---
	Eq_p_g8' = (-Eq_p_g8 - (Xd_g8 - Xd_p_g8)*Id_g8 + Efd_g8)/Tdo_p_g8
	Ed_p_g8' = (-Ed_p_g8 + (Xq_g8 - Xq_p_g8)*Iq_g8)/Tqo_p_g8
	δ_g8'    = (ω_g8 - ω_ref) * ω_s
	ω_g8'    = (P_gmr_8 - (Ed_p_g8 * Id_g8 + Eq_p_g8 * Iq_g8 + (Xq_p_g8 - Xd_p_g8) * Id_g8 * Iq_g8) - D_g8*(ω_g8 - ω_ref)) * ω_s /(2*H_g8)
	Efd_g8'  = (-(Ke_g8 + Se_g8)*Efd_g8 + VR_g8)/Te_g8
	Rf_g8'   = (-Rf_g8 + (Kf_g8/Tf_g8)*Efd_g8)/Tf_g8
	VR_g8'   = (-VR_g8 + Ka_g8*Rf_g8 - (Ka_g8*Kf_g8/Tf_g8)*Efd_g8 + Ka_g8*(Vref_g8 - V_8))/Ta_g8
	P_gmr_8' = (ω_ref - ω_g8) / (T_gov_g8 * R_g8 * ω_ref)

	// --- G9 ---
	Eq_p_g9' = (-Eq_p_g9 - (Xd_g9 - Xd_p_g9)*Id_g9 + Efd_g9)/Tdo_p_g9
	Ed_p_g9' = (-Ed_p_g9 + (Xq_g9 - Xq_p_g9)*Iq_g9)/Tqo_p_g9
	δ_g9'    = (ω_g9 - ω_ref) * ω_s
	ω_g9'    = (P_gmr_9 - (Ed_p_g9 * Id_g9 + Eq_p_g9 * Iq_g9 + (Xq_p_g9 - Xd_p_g9) * Id_g9 * Iq_g9) - D_g9*(ω_g9 - ω_ref)) * ω_s /(2*H_g9)
	Efd_g9'  = (-(Ke_g9 + Se_g9)*Efd_g9 + VR_g9)/Te_g9
	Rf_g9'   = (-Rf_g9 + (Kf_g9/Tf_g9)*Efd_g9)/Tf_g9
	VR_g9'   = (-VR_g9 + Ka_g9*Rf_g9 - (Ka_g9*Kf_g9/Tf_g9)*Efd_g9 + Ka_g9*(Vref_g9 - V_9))/Ta_g9
	P_gmr_9' = (ω_ref - ω_g9) / (T_gov_g9 * R_g9 * ω_ref)

	// --- G12 ---
	Eq_p_g12' = (-Eq_p_g12 - (Xd_g12 - Xd_p_g12)*Id_g12 + Efd_g12)/Tdo_p_g12
	Ed_p_g12' = (-Ed_p_g12 + (Xq_g12 - Xq_p_g12)*Iq_g12)/Tqo_p_g12
	δ_g12'    = (ω_g12 - ω_ref) * ω_s
	ω_g12'    = (P_gmr_12 - (Ed_p_g12 * Id_g12 + Eq_p_g12 * Iq_g12 + (Xq_p_g12 - Xd_p_g12) * Id_g12 * Iq_g12) - D_g12*(ω_g12 - ω_ref)) * ω_s /(2*H_g12)
	Efd_g12'  = (-(Ke_g12 + Se_g12)*Efd_g12 + VR_g12)/Te_g12
	Rf_g12'   = (-Rf_g12 + (Kf_g12/Tf_g12)*Efd_g12)/Tf_g12
	VR_g12'   = (-VR_g12 + Ka_g12*Rf_g12 - (Ka_g12*Kf_g12/Tf_g12)*Efd_g12 + Ka_g12*(Vref_g12 - V_12))/Ta_g12
	P_gmr_12' = (ω_ref - ω_g12) / (T_gov_g12 * R_g12 * ω_ref)
NLEs:
	// Stator algebraic equations
	Id_g1 = (Rs_g1 * (Ed_p_g1 - V_1 * sin(δ_g1 - δ_1)) + Xq_p_g1 * (Eq_p_g1 - V_1 * cos(δ_g1 - δ_1))) / (Rs_g1^2 + Xd_p_g1 * Xq_p_g1)
	Iq_g1 = (-Xd_p_g1 * (Ed_p_g1 - V_1 * sin(δ_g1 - δ_1)) + Rs_g1 * (Eq_p_g1 - V_1 * cos(δ_g1 - δ_1))) / (Rs_g1^2 + Xd_p_g1 * Xq_p_g1)
	Id_g2 = (Rs_g2 * (Ed_p_g2 - V_2 * sin(δ_g2 - δ_2)) + Xq_p_g2 * (Eq_p_g2 - V_2 * cos(δ_g2 - δ_2))) / (Rs_g2^2 + Xd_p_g2 * Xq_p_g2)
	Iq_g2 = (-Xd_p_g2 * (Ed_p_g2 - V_2 * sin(δ_g2 - δ_2)) + Rs_g2 * (Eq_p_g2 - V_2 * cos(δ_g2 - δ_2))) / (Rs_g2^2 + Xd_p_g2 * Xq_p_g2)
	Id_g3 = (Rs_g3 * (Ed_p_g3 - V_3 * sin(δ_g3 - δ_3)) + Xq_p_g3 * (Eq_p_g3 - V_3 * cos(δ_g3 - δ_3))) / (Rs_g3^2 + Xd_p_g3 * Xq_p_g3)
	Iq_g3 = (-Xd_p_g3 * (Ed_p_g3 - V_3 * sin(δ_g3 - δ_3)) + Rs_g3 * (Eq_p_g3 - V_3 * cos(δ_g3 - δ_3))) / (Rs_g3^2 + Xd_p_g3 * Xq_p_g3)
	Id_g6 = (Rs_g6 * (Ed_p_g6 - V_6 * sin(δ_g6 - δ_6)) + Xq_p_g6 * (Eq_p_g6 - V_6 * cos(δ_g6 - δ_6))) / (Rs_g6^2 + Xd_p_g6 * Xq_p_g6)
	Iq_g6 = (-Xd_p_g6 * (Ed_p_g6 - V_6 * sin(δ_g6 - δ_6)) + Rs_g6 * (Eq_p_g6 - V_6 * cos(δ_g6 - δ_6))) / (Rs_g6^2 + Xd_p_g6 * Xq_p_g6)
	Id_g8 = (Rs_g8 * (Ed_p_g8 - V_8 * sin(δ_g8 - δ_8)) + Xq_p_g8 * (Eq_p_g8 - V_8 * cos(δ_g8 - δ_8))) / (Rs_g8^2 + Xd_p_g8 * Xq_p_g8)
	Iq_g8 = (-Xd_p_g8 * (Ed_p_g8 - V_8 * sin(δ_g8 - δ_8)) + Rs_g8 * (Eq_p_g8 - V_8 * cos(δ_g8 - δ_8))) / (Rs_g8^2 + Xd_p_g8 * Xq_p_g8)
	Id_g9 = (Rs_g9 * (Ed_p_g9 - V_9 * sin(δ_g9 - δ_9)) + Xq_p_g9 * (Eq_p_g9 - V_9 * cos(δ_g9 - δ_9))) / (Rs_g9^2 + Xd_p_g9 * Xq_p_g9)
	Iq_g9 = (-Xd_p_g9 * (Ed_p_g9 - V_9 * sin(δ_g9 - δ_9)) + Rs_g9 * (Eq_p_g9 - V_9 * cos(δ_g9 - δ_9))) / (Rs_g9^2 + Xd_p_g9 * Xq_p_g9)
	Id_g12 = (Rs_g12 * (Ed_p_g12 - V_12 * sin(δ_g12 - δ_12)) + Xq_p_g12 * (Eq_p_g12 - V_12 * cos(δ_g12 - δ_12))) / (Rs_g12^2 + Xd_p_g12 * Xq_p_g12)
	Iq_g12 = (-Xd_p_g12 * (Ed_p_g12 - V_12 * sin(δ_g12 - δ_12)) + Rs_g12 * (Eq_p_g12 - V_12 * cos(δ_g12 - δ_12))) / (Rs_g12^2 + Xd_p_g12 * Xq_p_g12)

	// Elec. power
	Pe_g1 = Ed_p_g1 * Id_g1 + Eq_p_g1 * Iq_g1 + (Xq_p_g1 - Xd_p_g1) * Id_g1 * Iq_g1
	Pe_g2 = Ed_p_g2 * Id_g2 + Eq_p_g2 * Iq_g2 + (Xq_p_g2 - Xd_p_g2) * Id_g2 * Iq_g2
	Pe_g3 = Ed_p_g3 * Id_g3 + Eq_p_g3 * Iq_g3 + (Xq_p_g3 - Xd_p_g3) * Id_g3 * Iq_g3
	Pe_g6 = Ed_p_g6 * Id_g6 + Eq_p_g6 * Iq_g6 + (Xq_p_g6 - Xd_p_g6) * Id_g6 * Iq_g6
	Pe_g8 = Ed_p_g8 * Id_g8 + Eq_p_g8 * Iq_g8 + (Xq_p_g8 - Xd_p_g8) * Id_g8 * Iq_g8
	Pe_g9 = Ed_p_g9 * Id_g9 + Eq_p_g9 * Iq_g9 + (Xq_p_g9 - Xd_p_g9) * Id_g9 * Iq_g9
	Pe_g12 = Ed_p_g12 * Id_g12 + Eq_p_g12 * Iq_g12 + (Xq_p_g12 - Xd_p_g12) * Id_g12 * Iq_g12

	// PF for PV
	// node 1 - PV
	Id_g1*sin(δ_g1) + Iq_g1*cos(δ_g1) =	Y_1_1*V_1*cos(θ_1_1+δ_1) + Y_1_17*V_17*cos(θ_1_17+δ_17) + Y_1_2*V_2*cos(θ_1_2+δ_2) + Y_1_15*V_15*cos(θ_1_15+δ_15) + Y_1_16*V_16*cos(θ_1_16+δ_16)
	Iq_g1*sin(δ_g1) - Id_g1*cos(δ_g1) =	Y_1_1*V_1*sin(θ_1_1+δ_1) + Y_1_17*V_17*sin(θ_1_17+δ_17) + Y_1_2*V_2*sin(θ_1_2+δ_2) + Y_1_15*V_15*sin(θ_1_15+δ_15) + Y_1_16*V_16*sin(θ_1_16+δ_16)
	// node 2 - PV
	Id_g2*sin(δ_g2) + Iq_g2*cos(δ_g2) =	Y_2_2*V_2*cos(θ_2_2+δ_2) + Y_2_1*V_1_init*cos(θ_2_1+δ_1_init) + Y_2_3*V_3*cos(θ_2_3+δ_3)
	Iq_g2*sin(δ_g2) - Id_g2*cos(δ_g2) =	Y_2_2*V_2*sin(θ_2_2+δ_2) + Y_2_1*V_1_init*sin(θ_2_1+δ_1_init) + Y_2_3*V_3*sin(θ_2_3+δ_3)
	// node 3 - PV
	Id_g3*sin(δ_g3) + Iq_g3*cos(δ_g3) =	Y_3_3*V_3*cos(θ_3_3+δ_3) + Y_3_2*V_2*cos(θ_3_2+δ_2) + Y_3_4*V_4*cos(θ_3_4+δ_4) + Y_3_15*V_15*cos(θ_3_15+δ_15)
	Iq_g3*sin(δ_g3) - Id_g3*cos(δ_g3) =	Y_3_3*V_3*sin(θ_3_3+δ_3) + Y_3_2*V_2*sin(θ_3_2+δ_2) + Y_3_4*V_4*sin(θ_3_4+δ_4) + Y_3_15*V_15*sin(θ_3_15+δ_15)
	// node 6 - PV
	Id_g6*sin(δ_g6) + Iq_g6*cos(δ_g6) =	Y_6_6*V_6*cos(θ_6_6+δ_6) + Y_6_4*V_4*cos(θ_6_4+δ_4) + Y_6_5*V_5*cos(θ_6_5+δ_5) + Y_6_7*V_7*cos(θ_6_7+δ_7) + Y_6_8*V_8*cos(θ_6_8+δ_8)
	Iq_g6*sin(δ_g6) - Id_g6*cos(δ_g6) =	Y_6_6*V_6*sin(θ_6_6+δ_6) + Y_6_4*V_4*sin(θ_6_4+δ_4) + Y_6_5*V_5*sin(θ_6_5+δ_5) + Y_6_7*V_7*sin(θ_6_7+δ_7) + Y_6_8*V_8*sin(θ_6_8+δ_8)
	// node 8 - PV
	Id_g8*sin(δ_g8) + Iq_g8*cos(δ_g8) =	Y_8_8*V_8*cos(θ_8_8+δ_8) + Y_8_9*V_9*cos(θ_8_9+δ_9) + Y_8_6*V_6*cos(θ_8_6+δ_6) + Y_8_7*V_7*cos(θ_8_7+δ_7)
	Iq_g8*sin(δ_g8) - Id_g8*cos(δ_g8) =	Y_8_8*V_8*sin(θ_8_8+δ_8) + Y_8_9*V_9*sin(θ_8_9+δ_9) + Y_8_6*V_6*sin(θ_8_6+δ_6) + Y_8_7*V_7*sin(θ_8_7+δ_7)
