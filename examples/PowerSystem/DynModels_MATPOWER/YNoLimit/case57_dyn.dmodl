	Y_48_48*V_48*sin(θ_48_48+δ_48) + Y_48_49*V_49*sin(θ_48_49+δ_49) + Y_48_38*V_38*sin(θ_48_38+δ_38) + Y_48_47*V_47*sin(θ_48_47+δ_47) = 0
	// node 49 - PQ
	Y_49_49*V_49*cos(θ_49_49+δ_49) + Y_49_50*V_50*cos(θ_49_50+δ_50) + Y_49_13*V_13*cos(θ_49_13+δ_13) + Y_49_38*V_38*cos(θ_49_38+δ_38) + Y_49_48*V_48*cos(θ_49_48+δ_48) = 0
	Y_49_49*V_49*sin(θ_49_49+δ_49) + Y_49_50*V_50*sin(θ_49_50+δ_50) + Y_49_13*V_13*sin(θ_49_13+δ_13) + Y_49_38*V_38*sin(θ_49_38+δ_38) + Y_49_48*V_48*sin(θ_49_48+δ_48) = 0
	// node 50 - PQ
	Y_50_50*V_50*cos(θ_50_50+δ_50) + Y_50_49*V_49*cos(θ_50_49+δ_49) + Y_50_51*V_51*cos(θ_50_51+δ_51) = 0
	Y_50_50*V_50*sin(θ_50_50+δ_50) + Y_50_49*V_49*sin(θ_50_49+δ_49) + Y_50_51*V_51*sin(θ_50_51+δ_51) = 0
	// node 51 - PQ
	Y_51_51*V_51*cos(θ_51_51+δ_51) + Y_51_50*V_50*cos(θ_51_50+δ_50) + Y_51_10*V_10*cos(θ_51_10+δ_10) = 0
	Y_51_51*V_51*sin(θ_51_51+δ_51) + Y_51_50*V_50*sin(θ_51_50+δ_50) + Y_51_10*V_10*sin(θ_51_10+δ_10) = 0
	// node 52 - PQ
	Y_52_52*V_52*cos(θ_52_52+δ_52) + Y_52_29*V_29*cos(θ_52_29+δ_29) + Y_52_53*V_53*cos(θ_52_53+δ_53) = 0
	Y_52_52*V_52*sin(θ_52_52+δ_52) + Y_52_29*V_29*sin(θ_52_29+δ_29) + Y_52_53*V_53*sin(θ_52_53+δ_53) = 0
	// node 53 - PQ
	Y_53_53*V_53*cos(θ_53_53+δ_53) + Y_53_52*V_52*cos(θ_53_52+δ_52) + Y_53_54*V_54*cos(θ_53_54+δ_54) = 0
	Y_53_53*V_53*sin(θ_53_53+δ_53) + Y_53_52*V_52*sin(θ_53_52+δ_52) + Y_53_54*V_54*sin(θ_53_54+δ_54) = 0
	// node 54 - PQ
	Y_54_54*V_54*cos(θ_54_54+δ_54) + Y_54_53*V_53*cos(θ_54_53+δ_53) + Y_54_55*V_55*cos(θ_54_55+δ_55) = 0
	Y_54_54*V_54*sin(θ_54_54+δ_54) + Y_54_53*V_53*sin(θ_54_53+δ_53) + Y_54_55*V_55*sin(θ_54_55+δ_55) = 0
	// node 55 - PQ
	Y_55_55*V_55*cos(θ_55_55+δ_55) + Y_55_9*V_9*cos(θ_55_9+δ_9) + Y_55_54*V_54*cos(θ_55_54+δ_54) = 0
	Y_55_55*V_55*sin(θ_55_55+δ_55) + Y_55_9*V_9*sin(θ_55_9+δ_9) + Y_55_54*V_54*sin(θ_55_54+δ_54) = 0
	// node 56 - PQ
	Y_56_56*V_56*cos(θ_56_56+δ_56) + Y_56_41*V_41*cos(θ_56_41+δ_41) + Y_56_42*V_42*cos(θ_56_42+δ_42) + Y_56_57*V_57*cos(θ_56_57+δ_57) + Y_56_40*V_40*cos(θ_56_40+δ_40) = 0
	Y_56_56*V_56*sin(θ_56_56+δ_56) + Y_56_41*V_41*sin(θ_56_41+δ_41) + Y_56_42*V_42*sin(θ_56_42+δ_42) + Y_56_57*V_57*sin(θ_56_57+δ_57) + Y_56_40*V_40*sin(θ_56_40+δ_40) = 0
	// node 57 - PQ
	Y_57_57*V_57*cos(θ_57_57+δ_57) + Y_57_39*V_39*cos(θ_57_39+δ_39) + Y_57_56*V_56*cos(θ_57_56+δ_56) = 0
	Y_57_57*V_57*sin(θ_57_57+δ_57) + Y_57_39*V_39*sin(θ_57_39+δ_39) + Y_57_56*V_56*sin(θ_57_56+δ_56) = 0

	PostProc: 	//Simulate on/off or max PQ load
		if t >= 0.5:
			if t < 6:
				Y_16_16 = Y_16_16_fault 	//off between 0.5 and 6 sec
				θ_16_16 = θ_16_16_fault
			else:
				Y_16_16 = Y_16_16_reg 	//on again after 6 sec
				θ_16_16 = θ_16_16_reg
			end
		end
end
