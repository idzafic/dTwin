Header:
	newTab = false
end
Model [name="Visual of Dynamics"]:
Plots:
	linePlot [xLabel="Time [s]" yLabel="Speed [p.u.]" name="Gen. speeds"]:
		@x << t
		@y << ω_g1 [colorL=black colorD=white width=2 pattern="solid" name="ω_g1"]
		@y << ω_g2 [colorL=darkRed colorD=magenta width=2 pattern="solid" name="ω_g2"]
		@y << ω_g3 [colorL=darkBlue colorD=cyan width=2 pattern="solid" name="ω_g3"]
		@y << ω_g6 [colorL=darkGreen colorD=yellow width=2 pattern="solid" name="ω_g6"]
		@y << ω_g8 [colorL=purple colorD=orange width=2 pattern="solid" name="ω_g8"]
		@y << ω_g9 [colorL=saddleBrown colorD=lime width=2 pattern="solid" name="ω_g9"]
		@y << ω_g12 [colorL=indigo colorD=lightBlue width=2 pattern="solid" name="ω_g12"]
		@y << ω_ref [colorL=black colorD=white width=1 pattern="dot" name="Ref. ω"]
	end

	linePlot [xLabel="Time [s]" yLabel="Power [p.u.]" name="Gen. Powers"]:
		@x << t
		@y << P_gml_1 [colorL=black colorD=white width=2 name="Pgm_1"]
		@y << P_gml_2 [colorL=darkRed colorD=magenta width=2 name="Pgm_2"]
		@y << P_gml_3 [colorL=darkBlue colorD=cyan width=2 name="Pgm_3"]
		@y << P_gml_6 [colorL=darkGreen colorD=yellow width=2 name="Pgm_6"]
		@y << P_gml_8 [colorL=purple colorD=orange width=2 name="Pgm_8"]
		@y << P_gml_9 [colorL=saddleBrown colorD=lime width=2 name="Pgm_9"]
		@y << P_gml_12 [colorL=indigo colorD=lightBlue width=2 name="Pgm_12"]
	end

	linePlot [xLabel="Time [s]" yLabel="Angle [rad]" name="Rotor Angles"]:
		@x << t
		@y << δ_g1 [colorL=black colorD=white width=2 pattern="solid" name="δ_g1"]
		@y << δ_g2 [colorL=darkRed colorD=magenta width=2 pattern="solid" name="δ_g2"]
		@y << δ_g3 [colorL=darkBlue colorD=cyan width=2 pattern="solid" name="δ_g3"]
		@y << δ_g6 [colorL=darkGreen colorD=yellow width=2 pattern="solid" name="δ_g6"]
		@y << δ_g8 [colorL=purple colorD=orange width=2 pattern="solid" name="δ_g8"]
		@y << δ_g9 [colorL=saddleBrown colorD=lime width=2 pattern="solid" name="δ_g9"]
		@y << δ_g12 [colorL=indigo colorD=lightBlue width=2 pattern="solid" name="δ_g12"]
	end

	linePlot [xLabel="Time [s]" yLabel="Voltage [p.u.]" name="Gen. Bus Voltages"]:
		@x << t
		@y << V_1 [colorL=black  colorD=white width=2 name="Vt_g1"]
		@y << V_2 [colorL=darkRed  colorD=magenta width=2 name="Vt_g2"]
		@y << V_3 [colorL=darkBlue  colorD=cyan width=2 name="Vt_g3"]
		@y << V_6 [colorL=darkGreen  colorD=yellow width=2 name="Vt_g6"]
		@y << V_8 [colorL=purple  colorD=orange width=2 name="Vt_g8"]
		@y << V_9 [colorL=saddleBrown  colorD=lime width=2 name="Vt_g9"]
		@y << V_12 [colorL=indigo  colorD=lightBlue width=2 name="Vt_g12"]
	end

end
