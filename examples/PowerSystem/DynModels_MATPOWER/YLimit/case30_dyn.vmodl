Header:
	newTab = false
end
Model [name="Visual of Dynamics"]:
Plots:
	linePlot [xLabel="Time [s]" yLabel="Speed [p.u.]" name="Gen. speeds"]:
		@x << t
		@y << ω_g1 [colorL=black colorD=white width=2 pattern="solid" name="ω_g1"]
		@y << ω_g2 [colorL=darkRed colorD=magenta width=2 pattern="solid" name="ω_g2"]
		@y << ω_g13 [colorL=darkBlue colorD=cyan width=2 pattern="solid" name="ω_g13"]
		@y << ω_g22 [colorL=darkGreen colorD=yellow width=2 pattern="solid" name="ω_g22"]
		@y << ω_g23 [colorL=purple colorD=orange width=2 pattern="solid" name="ω_g23"]
		@y << ω_g27 [colorL=saddleBrown colorD=lime width=2 pattern="solid" name="ω_g27"]
		@y << ω_ref [colorL=black colorD=white width=1 pattern="dot" name="Ref. ω"]
	end

	linePlot [xLabel="Time [s]" yLabel="Power [p.u.]" name="Gen. Powers"]:
		@x << t
		@y << P_gml_1 [colorL=black colorD=white width=2 name="Pgm_1"]
		@y << P_gml_2 [colorL=darkRed colorD=magenta width=2 name="Pgm_2"]
		@y << P_gml_13 [colorL=darkBlue colorD=cyan width=2 name="Pgm_13"]
		@y << P_gml_22 [colorL=darkGreen colorD=yellow width=2 name="Pgm_22"]
		@y << P_gml_23 [colorL=purple colorD=orange width=2 name="Pgm_23"]
		@y << P_gml_27 [colorL=saddleBrown colorD=lime width=2 name="Pgm_27"]
	end

	linePlot [xLabel="Time [s]" yLabel="Angle [rad]" name="Rotor Angles"]:
		@x << t
		@y << δ_g1 [colorL=black colorD=white width=2 pattern="solid" name="δ_g1"]
		@y << δ_g2 [colorL=darkRed colorD=magenta width=2 pattern="solid" name="δ_g2"]
		@y << δ_g13 [colorL=darkBlue colorD=cyan width=2 pattern="solid" name="δ_g13"]
		@y << δ_g22 [colorL=darkGreen colorD=yellow width=2 pattern="solid" name="δ_g22"]
		@y << δ_g23 [colorL=purple colorD=orange width=2 pattern="solid" name="δ_g23"]
		@y << δ_g27 [colorL=saddleBrown colorD=lime width=2 pattern="solid" name="δ_g27"]
	end

	linePlot [xLabel="Time [s]" yLabel="Voltage [p.u.]" name="Gen. Bus Voltages"]:
		@x << t
		@y << V_1 [colorL=black  colorD=white width=2 name="Vt_g1"]
		@y << V_2 [colorL=darkRed  colorD=magenta width=2 name="Vt_g2"]
		@y << V_13 [colorL=darkBlue  colorD=cyan width=2 name="Vt_g13"]
		@y << V_22 [colorL=darkGreen  colorD=yellow width=2 name="Vt_g22"]
		@y << V_23 [colorL=purple  colorD=orange width=2 name="Vt_g23"]
		@y << V_27 [colorL=saddleBrown  colorD=lime width=2 name="Vt_g27"]
	end

end
