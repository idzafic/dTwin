	Efd_g13'  = (-(Ke_g13 + Se_g13)*Efd_g13 + VR_g13)/Te_g13
	Rf_g13'   = (-Rf_g13 + (Kf_g13/Tf_g13)*Efd_g13)/Tf_g13
	VR_g13'   = (-VR_g13 + Ka_g13*Rf_g13 - (Ka_g13*Kf_g13/Tf_g13)*Efd_g13 + Ka_g13*(Vref_g13 - V_13))/Ta_g13
	P_gmr_13' = (ω_ref - ω_g13) / (T_gov_g13 * R_g13 * ω_ref)

