	-Y_25_25*V_25*sin(θ_25_25) + Y_25_26*V_26*sin(δ_25-θ_25_26-δ_26) + Y_25_27*V_27*sin(δ_25-θ_25_27-δ_27) + Y_25_24*V_24*sin(δ_25-θ_25_24-δ_24) = 0
	// node 26 - PQ
	Y_26_26*V_26^2*cos(θ_26_26) + V_26 * (Y_26_25*V_25*cos(δ_26-θ_26_25-δ_25)) = P_26
	-Y_26_26*V_26^2*sin(θ_26_26) + V_26 * (Y_26_25*V_25*sin(δ_26-θ_26_25-δ_25)) = Q_26
	// node 28 - PQ (ZI)
	Y_28_28*V_28*cos(θ_28_28) + Y_28_27*V_27*cos(δ_28-θ_28_27-δ_27) + Y_28_6*V_6*cos(δ_28-θ_28_6-δ_6) + Y_28_8*V_8*cos(δ_28-θ_28_8-δ_8) = 0
	-Y_28_28*V_28*sin(θ_28_28) + Y_28_27*V_27*sin(δ_28-θ_28_27-δ_27) + Y_28_6*V_6*sin(δ_28-θ_28_6-δ_6) + Y_28_8*V_8*sin(δ_28-θ_28_8-δ_8) = 0
	// node 29 - PQ
	Y_29_29*V_29^2*cos(θ_29_29) + V_29 * (Y_29_27*V_27*cos(δ_29-θ_29_27-δ_27) + Y_29_30*V_30*cos(δ_29-θ_29_30-δ_30)) = P_29
	-Y_29_29*V_29^2*sin(θ_29_29) + V_29 * (Y_29_27*V_27*sin(δ_29-θ_29_27-δ_27) + Y_29_30*V_30*sin(δ_29-θ_29_30-δ_30)) = Q_29
	// node 30 - PQ
	Y_30_30*V_30^2*cos(θ_30_30) + V_30 * (Y_30_27*V_27*cos(δ_30-θ_30_27-δ_27) + Y_30_29*V_29*cos(δ_30-θ_30_29-δ_29)) = P_30
	-Y_30_30*V_30^2*sin(θ_30_30) + V_30 * (Y_30_27*V_27*sin(δ_30-θ_30_27-δ_27) + Y_30_29*V_29*sin(δ_30-θ_30_29-δ_29)) = Q_30

	PostProc: 	//Simulate on/off or max PQ load
		if t >= 0.5:
			if t < 6:
				P_8 = 0 	//off between 0.5 and 6 sec
				Q_8 = 0
			else:
				P_8 = -0.3 	//on again after 6 sec
				Q_8 = -0.3
			end
		end
end
