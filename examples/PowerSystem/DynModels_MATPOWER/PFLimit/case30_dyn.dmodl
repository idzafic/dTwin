	Efd_g27'  = (-(Ke_g27 + Se_g27)*Efd_g27 + VR_g27)/Te_g27
	Rf_g27'   = (-Rf_g27 + (Kf_g27/Tf_g27)*Efd_g27)/Tf_g27
