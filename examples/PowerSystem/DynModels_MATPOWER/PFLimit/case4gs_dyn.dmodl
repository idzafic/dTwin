Header:
	maxIter=100
	report=All	//Solved - only final solved solution, All - shows solved and nonSolved with iterations, AllDetails - All + debug information
	maxReps = -1
	outToTxt = false
	startTime = 0	//Solution start time for time domain (ODE and DAE) problems
	dTime = 1e-3	//Integration time step for time domain (ODE and DAE) problems
	endTime = 12
end
//Generated by MATPOWER to dmodl coverter
Model [type=DAE domain=real eps=1e-8 name="DAE:case4gs-polar" method=RK2 simplify=true pivot=Markowitz]:
Vars [out=true]:
	δ_1 = 0.0; V_1 = 1.0
	δ_2 = 0.0; V_2 = 1.0
	δ_3 = 0.0; V_3 = 1.0
	δ_4 = 0.0; V_4 = 1.0
	// Dynamic variables for slack bus 1
	δ_g1; ω_g1 = ω_ref; Eq_p_g1; Ed_p_g1; Efd_g1; Rf_g1; VR_g1; P_gmr_1; P_gml_1
	Id_g1; Iq_g1; Pe_g1
	// Dynamic variables for PV bus 4
	δ_g4; ω_g4 = ω_ref; Eq_p_g4; Ed_p_g4; Efd_g4; Rf_g4; VR_g4; P_gmr_4; P_gml_4
	Id_g4; Iq_g4; Pe_g4
Params:
	δ_1_init = 0.0 [out=true]; 	V_1_init = 1.0 [out=true]
	Y_1_1 = 45.72741251626922; θ_1_1 = -1.3730147741317456 
	Y_1_2 = 19.455965787518256; θ_1_2 = 1.7681918866447774 
	Y_1_3 = 26.359695583089252; θ_1_3 = 1.7681918866447774 
	Y_2_2 = 45.72741251626922; θ_2_2 = -1.3730147741317456 
	Y_2_1 = 19.455965787518256; θ_2_1 = 1.7681918866447774 
	Y_2_4 = 26.359695583089252; θ_2_4 = 1.7681918866447774 
	Y_3_3 = 41.6771260640257; θ_3_3 = -1.3729184423096705 
	Y_3_1 = 26.359695583089252; θ_3_1 = 1.7681918866447774 
	Y_3_4 = 15.417935152372957; θ_3_4 = 1.7681918866447774 
	Y_4_4 = 41.6771260640257; θ_4_4 = -1.3729184423096705 
	Y_4_2 = 26.359695583089252; θ_4_2 = 1.7681918866447774 
	Y_4_3 = 15.417935152372957; θ_4_3 = 1.7681918866447774 
	P_1 = -0.5; Q_1 = -0.3099
	P_1_l = 0.5; Q_1_l = 0.3099
	P_2 = -1.7
	Q_2 = -1.0534999999999999
	P_3 = -2.0
	Q_3 = -1.2394
	P_4_g = 3.18; Q_4_g = 0.0; P_4 = 2.38; Q_4 = -0.49579999999999996
	P_4_l = 0.8; Q_4_l = 0.49579999999999996
	V_4_sp = 1.02
	
	Tm_g1; Vref_g1
	Tm_g4; Vref_g4
	f_s = 50; ω_ref = 1; ω_s = 2*pi*f_s;
	// Dynamic parameters for gen 1
	H_g1 = 6.4; D_g1 = 28
	Xd_g1 = 0.146; Xd_p_g1 = 0.0608; Xq_g1 = 0.0969; Xq_p_g1 = 0.0969;
	Tdo_p_g1 = 8.96; Tqo_p_g1 = 0.31; Tr_g1 = 0.02; T_gov_g1 = 0.3
	Ka_g1 = 250.0; Ta_g1 = 0.02; Ke_g1 = 1.0; Te_g1 = 0.8
	R_g1 = 0.05; Rs_g1 = 0.07; Se_g1 = 0
	Kf_g1 = 0.063; Tf_g1 = 1 

	// Dynamic parameters for gen 4
	H_g4 = 6.4; D_g4 = 28
	Xd_g4 = 0.146; Xd_p_g4 = 0.0608; Xq_g4 = 0.0969; Xq_p_g4 = 0.0969;
	Tdo_p_g4 = 8.96; Tqo_p_g4 = 0.31; Tr_g4 = 0.02; T_gov_g4 = 0.3
	Ka_g4 = 250.0; Ta_g4 = 0.02; Ke_g4 = 1.0; Te_g4 = 0.8
	R_g4 = 0.05; Rs_g4 = 0.07; Se_g4 = 0
	Kf_g4 = 0.063; Tf_g4 = 1 

SubModel [type=NL name="Initialization" copyPars=-1 eps=1e-8 pivot="Diagonal"]:
Vars [out=true]:
	δ_2 = 0.0; V_2 = 1.0
	δ_3 = 0.0; V_3 = 1.0
	δ_4 = 0.0; V_4 = 1.0
Params:
	// Gen 1 initials
	P_1_init; Q_1_init
	I_r1_init; I_i1_init; Eq_r1_init; Eq_i1_init
	I_d1_init; I_q1_init; V_d1_init; V_q1_init 
	E_d1_p_init; E_q1_p_init; Tm1_init; Vt_g1_init
	Ef_d1_init; VR1_init; Rf1_init; Vref1_init
	// Gen 4 initials
	P_4_init; Q_4_init
	I_r4_init; I_i4_init; Eq_r4_init; Eq_i4_init
	I_d4_init; I_q4_init; V_d4_init; V_q4_init 
	E_d4_p_init; E_q4_p_init; Tm4_init; Vt_g4_init
	Ef_d4_init; VR4_init; Rf4_init; Vref4_init
NLEs:
	// node 1 - SLACK
	// node 2 - PQ
	Y_2_2*V_2^2*cos(θ_2_2) + V_2 * (Y_2_1*V_1_init*cos(δ_2-θ_2_1-δ_1_init) + Y_2_4*V_4*cos(δ_2-θ_2_4-δ_4)) = P_2
	-Y_2_2*V_2^2*sin(θ_2_2) + V_2 * (Y_2_1*V_1_init*sin(δ_2-θ_2_1-δ_1_init) + Y_2_4*V_4*sin(δ_2-θ_2_4-δ_4)) = Q_2
	// node 3 - PQ
	Y_3_3*V_3^2*cos(θ_3_3) + V_3 * (Y_3_1*V_1_init*cos(δ_3-θ_3_1-δ_1_init) + Y_3_4*V_4*cos(δ_3-θ_3_4-δ_4)) = P_3
	-Y_3_3*V_3^2*sin(θ_3_3) + V_3 * (Y_3_1*V_1_init*sin(δ_3-θ_3_1-δ_1_init) + Y_3_4*V_4*sin(δ_3-θ_3_4-δ_4)) = Q_3
	// node 4 - PV
	Y_4_4*V_4^2*cos(θ_4_4) + V_4 * (Y_4_2*V_2*cos(δ_4-θ_4_2-δ_2) + Y_4_3*V_3*cos(δ_4-θ_4_3-δ_3)) = P_4
	V_4=V_4_sp
PostProc:
	P_1_init =	Y_1_1*V_1_init^2*cos(θ_1_1) + V_1_init * (Y_1_2*V_2*cos(δ_1_init-θ_1_2-δ_2) + Y_1_3*V_3*cos(δ_1_init-θ_1_3-δ_3))
	Q_1_init =	-Y_1_1*V_1_init^2*sin(θ_1_1) + V_1_init * (Y_1_2*V_2*sin(δ_1_init-θ_1_2-δ_2) + Y_1_3*V_3*sin(δ_1_init-θ_1_3-δ_3))
	Q_1_init = Q_1_init + Q_1_l
	P_1_init = P_1_init + P_1_l

	// Step 1:
	I_r1_init = (P_1_init*cos(δ_1_init) + Q_1_init*sin(δ_1_init))/V_1_init;
	I_i1_init = (P_1_init*sin(δ_1_init) - Q_1_init*cos(δ_1_init))/V_1_init;
	// Step 2:
	Eq_r1_init = V_1_init*cos(δ_1_init) + Rs_g1*I_r1_init - Xq_g1*I_i1_init
	Eq_i1_init = V_1_init*sin(δ_1_init) + Rs_g1*I_i1_init + Xq_g1*I_r1_init
	@main.δ_g1 = atg2(Eq_r1_init, Eq_i1_init)
	// Step 3:
	I_d1_init = I_r1_init*sin(@main.δ_g1) - I_i1_init*cos(@main.δ_g1)
	I_q1_init = I_r1_init*cos(@main.δ_g1) + I_i1_init*sin(@main.δ_g1)
	V_d1_init = V_1_init*sin(@main.δ_g1 - δ_1_init)
	V_q1_init = V_1_init*cos(@main.δ_g1 - δ_1_init)
	// Step 4:
	E_d1_p_init = (Xq_g1 - Xq_p_g1) * I_q1_init
	// Step 5:
	E_q1_p_init = V_q1_init + Rs_g1 * I_q1_init + Xd_p_g1 * I_d1_init
	// Step 6:
	Ef_d1_init = E_q1_p_init + (Xd_g1 - Xd_p_g1)*I_d1_init
	// Step 7:
	VR1_init = (Ke_g1 + Se_g1) * Ef_d1_init
	Rf1_init = (Kf_g1 / Tf_g1) * Ef_d1_init
	Vt_g1_init = V_1_init
	Vref1_init = V_1_init + (VR1_init / Ka_g1)
	@main.ω_g1 = ω_ref
	@main.Ed_p_g1 = E_d1_p_init
	@main.Eq_p_g1 = E_q1_p_init
	@main.VR_g1 = VR1_init
	@main.Rf_g1 = Rf1_init
	@main.Id_g1 = I_d1_init
	@main.Iq_g1 = I_q1_init
	@main.Efd_g1 = Ef_d1_init
	@main.Vref_g1 = Vref1_init
	Tm1_init = @main.Ed_p_g1*I_d1_init + @main.Eq_p_g1*I_q1_init + (Xq_p_g1 - Xd_p_g1)*I_d1_init*I_q1_init;
	@main.Pe_g1 = Tm1_init;
	@main.P_gmr_1 = Tm1_init;
	@main.P_gml_1 = Tm1_init;
	@main.Tm_g1 = Tm1_init;
	@main.Q_1 = Q_1_init
	@main.P_1 = P_1_init

	P_4_init =P_4_g
	Q_4_init =	-Y_4_4*V_4^2*sin(θ_4_4) + V_4 * (Y_4_2*V_2*sin(δ_4-θ_4_2-δ_2) + Y_4_3*V_3*sin(δ_4-θ_4_3-δ_3))
	Q_4_init = Q_4_init + Q_4_l

	// Step 1:
	I_r4_init = (P_4_init*cos(δ_4) + Q_4_init*sin(δ_4))/V_4;
	I_i4_init = (P_4_init*sin(δ_4) - Q_4_init*cos(δ_4))/V_4;
	// Step 2:
	Eq_r4_init = V_4*cos(δ_4) + Rs_g4*I_r4_init - Xq_g4*I_i4_init
	Eq_i4_init = V_4*sin(δ_4) + Rs_g4*I_i4_init + Xq_g4*I_r4_init
	@main.δ_g4 = atg2(Eq_r4_init, Eq_i4_init)
	// Step 3:
	I_d4_init = I_r4_init*sin(@main.δ_g4) - I_i4_init*cos(@main.δ_g4)
	I_q4_init = I_r4_init*cos(@main.δ_g4) + I_i4_init*sin(@main.δ_g4)
	V_d4_init = V_4*sin(@main.δ_g4 - δ_4)
	V_q4_init = V_4*cos(@main.δ_g4 - δ_4)
	// Step 4:
	E_d4_p_init = (Xq_g4 - Xq_p_g4) * I_q4_init
	// Step 5:
	E_q4_p_init = V_q4_init + Rs_g4 * I_q4_init + Xd_p_g4 * I_d4_init
	// Step 6:
	Ef_d4_init = E_q4_p_init + (Xd_g4 - Xd_p_g4)*I_d4_init
	// Step 7:
	VR4_init = (Ke_g4 + Se_g4) * Ef_d4_init
	Rf4_init = (Kf_g4 / Tf_g4) * Ef_d4_init
	Vt_g4_init = V_4
	Vref4_init = V_4 + (VR4_init / Ka_g4)
	@main.ω_g4 = ω_ref
	@main.Ed_p_g4 = E_d4_p_init
	@main.Eq_p_g4 = E_q4_p_init
	@main.VR_g4 = VR4_init
	@main.Rf_g4 = Rf4_init
	@main.Id_g4 = I_d4_init
	@main.Iq_g4 = I_q4_init
	@main.Efd_g4 = Ef_d4_init
	@main.Vref_g4 = Vref4_init
	Tm4_init = @main.Ed_p_g4*I_d4_init + @main.Eq_p_g4*I_q4_init + (Xq_p_g4 - Xd_p_g4)*I_d4_init*I_q4_init;
	@main.Pe_g4 = Tm4_init;
	@main.P_gmr_4 = Tm4_init;
	@main.P_gml_4 = Tm4_init;
	@main.Tm_g4 = Tm4_init;
	@main.Q_4_g = Q_4_init
	@main.P_4_g = P_4_init
	Q_4 = Q_4_init - Q_4_l

	@main.δ_1 = δ_1_init; @main.V_1 = V_1_init
	@main.δ_2 = δ_2; @main.V_2 = V_2
	@main.δ_3 = δ_3; @main.V_3 = V_3
	@main.δ_4 = δ_4; @main.V_4 = V_4
end
ODEs:

	// --- G1 ---
	Eq_p_g1' = (-Eq_p_g1 - (Xd_g1 - Xd_p_g1)*Id_g1 + Efd_g1)/Tdo_p_g1
	Ed_p_g1' = (-Ed_p_g1 + (Xq_g1 - Xq_p_g1)*Iq_g1)/Tqo_p_g1
	δ_g1'    = (ω_g1 - ω_ref) * ω_s
	ω_g1'    = (P_gml_1 - (Ed_p_g1 * Id_g1 + Eq_p_g1 * Iq_g1 + (Xq_p_g1 - Xd_p_g1) * Id_g1 * Iq_g1) - D_g1*(ω_g1 - ω_ref)) * ω_s /(2*H_g1)
	Efd_g1'  = (-(Ke_g1 + Se_g1)*Efd_g1 + VR_g1)/Te_g1
	Rf_g1'   = (-Rf_g1 + (Kf_g1/Tf_g1)*Efd_g1)/Tf_g1
	VR_g1'   = (-VR_g1 + Ka_g1*Rf_g1 - (Ka_g1*Kf_g1/Tf_g1)*Efd_g1 + Ka_g1*(Vref_g1 - V_1))/Ta_g1
	P_gmr_1' = (ω_ref - ω_g1) / (T_gov_g1 * R_g1 * ω_ref)

	// --- G4 ---
	Eq_p_g4' = (-Eq_p_g4 - (Xd_g4 - Xd_p_g4)*Id_g4 + Efd_g4)/Tdo_p_g4
	Ed_p_g4' = (-Ed_p_g4 + (Xq_g4 - Xq_p_g4)*Iq_g4)/Tqo_p_g4
	δ_g4'    = (ω_g4 - ω_ref) * ω_s
	ω_g4'    = (P_gml_4 - (Ed_p_g4 * Id_g4 + Eq_p_g4 * Iq_g4 + (Xq_p_g4 - Xd_p_g4) * Id_g4 * Iq_g4) - D_g4*(ω_g4 - ω_ref)) * ω_s /(2*H_g4)
	Efd_g4'  = (-(Ke_g4 + Se_g4)*Efd_g4 + VR_g4)/Te_g4
	Rf_g4'   = (-Rf_g4 + (Kf_g4/Tf_g4)*Efd_g4)/Tf_g4
	VR_g4'   = (-VR_g4 + Ka_g4*Rf_g4 - (Ka_g4*Kf_g4/Tf_g4)*Efd_g4 + Ka_g4*(Vref_g4 - V_4))/Ta_g4
	P_gmr_4' = (ω_ref - ω_g4) / (T_gov_g4 * R_g4 * ω_ref)
NLEs:
	// Stator algebraic equations
	Id_g1 = (Rs_g1 * (Ed_p_g1 - V_1 * sin(δ_g1 - δ_1)) + Xq_p_g1 * (Eq_p_g1 - V_1 * cos(δ_g1 - δ_1))) / (Rs_g1^2 + Xd_p_g1 * Xq_p_g1)
	Iq_g1 = (-Xd_p_g1 * (Ed_p_g1 - V_1 * sin(δ_g1 - δ_1)) + Rs_g1 * (Eq_p_g1 - V_1 * cos(δ_g1 - δ_1))) / (Rs_g1^2 + Xd_p_g1 * Xq_p_g1)
	P_gml_1=lim(P_gmr_1, 0.0, 6.36)
	Id_g4 = (Rs_g4 * (Ed_p_g4 - V_4 * sin(δ_g4 - δ_4)) + Xq_p_g4 * (Eq_p_g4 - V_4 * cos(δ_g4 - δ_4))) / (Rs_g4^2 + Xd_p_g4 * Xq_p_g4)
	Iq_g4 = (-Xd_p_g4 * (Ed_p_g4 - V_4 * sin(δ_g4 - δ_4)) + Rs_g4 * (Eq_p_g4 - V_4 * cos(δ_g4 - δ_4))) / (Rs_g4^2 + Xd_p_g4 * Xq_p_g4)
	P_gml_4=lim(P_gmr_4, -10, 10)

	// Elec. power
	Pe_g1 = Ed_p_g1 * Id_g1 + Eq_p_g1 * Iq_g1 + (Xq_p_g1 - Xd_p_g1) * Id_g1 * Iq_g1
	Pe_g4 = Ed_p_g4 * Id_g4 + Eq_p_g4 * Iq_g4 + (Xq_p_g4 - Xd_p_g4) * Id_g4 * Iq_g4

	// PF for PV
	// node 1 - PV
	V_1 * (Id_g1*sin(δ_g1 - δ_1) + Iq_g1*cos(δ_g1 - δ_1)) - P_1_l=	Y_1_1*V_1^2*cos(θ_1_1) + V_1 * (Y_1_2*V_2*cos(δ_1-θ_1_2-δ_2) + Y_1_3*V_3*cos(δ_1-θ_1_3-δ_3))
	V_1 * (Id_g1*cos(δ_g1 - δ_1) - Iq_g1*sin(δ_g1 - δ_1)) - Q_1_l=	-Y_1_1*V_1^2*sin(θ_1_1) + V_1 * (Y_1_2*V_2*sin(δ_1-θ_1_2-δ_2) + Y_1_3*V_3*sin(δ_1-θ_1_3-δ_3))
	// node 4 - PV
	V_4 * (Id_g4*sin(δ_g4 - δ_4) + Iq_g4*cos(δ_g4 - δ_4)) - P_4_l=	Y_4_4*V_4^2*cos(θ_4_4) + V_4 * (Y_4_2*V_2*cos(δ_4-θ_4_2-δ_2) + Y_4_3*V_3*cos(δ_4-θ_4_3-δ_3))
	V_4 * (Id_g4*cos(δ_g4 - δ_4) - Iq_g4*sin(δ_g4 - δ_4)) - Q_4_l=	-Y_4_4*V_4^2*sin(θ_4_4) + V_4 * (Y_4_2*V_2*sin(δ_4-θ_4_2-δ_2) + Y_4_3*V_3*sin(δ_4-θ_4_3-δ_3))

	// PF for PQ
	// node 2 - PQ
	Y_2_2*V_2^2*cos(θ_2_2) + V_2 * (Y_2_1*V_1*cos(δ_2-θ_2_1-δ_1) + Y_2_4*V_4*cos(δ_2-θ_2_4-δ_4)) = P_2
	-Y_2_2*V_2^2*sin(θ_2_2) + V_2 * (Y_2_1*V_1*sin(δ_2-θ_2_1-δ_1) + Y_2_4*V_4*sin(δ_2-θ_2_4-δ_4)) = Q_2
	// node 3 - PQ
	Y_3_3*V_3^2*cos(θ_3_3) + V_3 * (Y_3_1*V_1*cos(δ_3-θ_3_1-δ_1) + Y_3_4*V_4*cos(δ_3-θ_3_4-δ_4)) = P_3
	-Y_3_3*V_3^2*sin(θ_3_3) + V_3 * (Y_3_1*V_1*sin(δ_3-θ_3_1-δ_1) + Y_3_4*V_4*sin(δ_3-θ_3_4-δ_4)) = Q_3

	PostProc: 	//Simulate on/off or max PQ load
		if t >= 0.5:
			if t < 6:
				P_3 = 0 	//off between 0.5 and 6 sec
				Q_3 = 0
			else:
				P_3 = -2.0 	//on again after 6 sec
				Q_3 = -1.2394
			end
		end
end
