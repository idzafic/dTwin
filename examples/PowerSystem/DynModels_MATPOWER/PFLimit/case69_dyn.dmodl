ODEs:

	// --- G1 ---
	Eq_p_g1' = (-Eq_p_g1 - (Xd_g1 - Xd_p_g1)*Id_g1 + Efd_g1)/Tdo_p_g1
	Ed_p_g1' = (-Ed_p_g1 + (Xq_g1 - Xq_p_g1)*Iq_g1)/Tqo_p_g1
	δ_g1'    = (ω_g1 - ω_ref) * ω_s
	ω_g1'    = (P_gml_1 - (Ed_p_g1 * Id_g1 + Eq_p_g1 * Iq_g1 + (Xq_p_g1 - Xd_p_g1) * Id_g1 * Iq_g1) - D_g1*(ω_g1 - ω_ref)) * ω_s /(2*H_g1)
	Efd_g1'  = (-(Ke_g1 + Se_g1)*Efd_g1 + VR_g1)/Te_g1
	Rf_g1'   = (-Rf_g1 + (Kf_g1/Tf_g1)*Efd_g1)/Tf_g1
	VR_g1'   = (-VR_g1 + Ka_g1*Rf_g1 - (Ka_g1*Kf_g1/Tf_g1)*Efd_g1 + Ka_g1*(Vref_g1 - V_1))/Ta_g1
	P_gmr_1' = (ω_ref - ω_g1) / (T_gov_g1 * R_g1 * ω_ref)
NLEs:
	// Stator algebraic equations
	Id_g1 = (Rs_g1 * (Ed_p_g1 - V_1 * sin(δ_g1 - δ_1)) + Xq_p_g1 * (Eq_p_g1 - V_1 * cos(δ_g1 - δ_1))) / (Rs_g1^2 + Xd_p_g1 * Xq_p_g1)
	Iq_g1 = (-Xd_p_g1 * (Ed_p_g1 - V_1 * sin(δ_g1 - δ_1)) + Rs_g1 * (Eq_p_g1 - V_1 * cos(δ_g1 - δ_1))) / (Rs_g1^2 + Xd_p_g1 * Xq_p_g1)
	P_gml_1=lim(P_gmr_1, 0.0, 2.0)

	// Elec. power
	Pe_g1 = Ed_p_g1 * Id_g1 + Eq_p_g1 * Iq_g1 + (Xq_p_g1 - Xd_p_g1) * Id_g1 * Iq_g1

	// PF for PV
	// node 1 - PV
	V_1 * (Id_g1*sin(δ_g1 - δ_1) + Iq_g1*cos(δ_g1 - δ_1)) =	Y_1_1*V_1^2*cos(θ_1_1) + V_1 * (Y_1_2*V_2*cos(δ_1-θ_1_2-δ_2))
	V_1 * (Id_g1*cos(δ_g1 - δ_1) - Iq_g1*sin(δ_g1 - δ_1)) =	-Y_1_1*V_1^2*sin(θ_1_1) + V_1 * (Y_1_2*V_2*sin(δ_1-θ_1_2-δ_2))

	// PF for PQ
	// node 2 - PQ (ZI)
	Y_2_2*V_2*cos(θ_2_2) + Y_2_1*V_1*cos(δ_2-θ_2_1-δ_1) + Y_2_3*V_3*cos(δ_2-θ_2_3-δ_3) = 0
	-Y_2_2*V_2*sin(θ_2_2) + Y_2_1*V_1*sin(δ_2-θ_2_1-δ_1) + Y_2_3*V_3*sin(δ_2-θ_2_3-δ_3) = 0
	// node 3 - PQ (ZI)
	Y_3_3*V_3*cos(θ_3_3) + Y_3_28*V_28*cos(δ_3-θ_3_28-δ_28) + Y_3_2*V_2*cos(δ_3-θ_3_2-δ_2) + Y_3_4*V_4*cos(δ_3-θ_3_4-δ_4) + Y_3_36*V_36*cos(δ_3-θ_3_36-δ_36) = 0
	-Y_3_3*V_3*sin(θ_3_3) + Y_3_28*V_28*sin(δ_3-θ_3_28-δ_28) + Y_3_2*V_2*sin(δ_3-θ_3_2-δ_2) + Y_3_4*V_4*sin(δ_3-θ_3_4-δ_4) + Y_3_36*V_36*sin(δ_3-θ_3_36-δ_36) = 0
	// node 4 - PQ (ZI)
	Y_4_4*V_4*cos(θ_4_4) + Y_4_3*V_3*cos(δ_4-θ_4_3-δ_3) + Y_4_5*V_5*cos(δ_4-θ_4_5-δ_5) + Y_4_47*V_47*cos(δ_4-θ_4_47-δ_47) = 0
	-Y_4_4*V_4*sin(θ_4_4) + Y_4_3*V_3*sin(δ_4-θ_4_3-δ_3) + Y_4_5*V_5*sin(δ_4-θ_4_5-δ_5) + Y_4_47*V_47*sin(δ_4-θ_4_47-δ_47) = 0
	// node 5 - PQ (ZI)
	Y_5_5*V_5*cos(θ_5_5) + Y_5_4*V_4*cos(δ_5-θ_5_4-δ_4) + Y_5_6*V_6*cos(δ_5-θ_5_6-δ_6) = 0
	-Y_5_5*V_5*sin(θ_5_5) + Y_5_4*V_4*sin(δ_5-θ_5_4-δ_4) + Y_5_6*V_6*sin(δ_5-θ_5_6-δ_6) = 0
	// node 6 - PQ
	Y_6_6*V_6^2*cos(θ_6_6) + V_6 * (Y_6_5*V_5*cos(δ_6-θ_6_5-δ_5) + Y_6_7*V_7*cos(δ_6-θ_6_7-δ_7)) = P_6
	-Y_6_6*V_6^2*sin(θ_6_6) + V_6 * (Y_6_5*V_5*sin(δ_6-θ_6_5-δ_5) + Y_6_7*V_7*sin(δ_6-θ_6_7-δ_7)) = Q_6
