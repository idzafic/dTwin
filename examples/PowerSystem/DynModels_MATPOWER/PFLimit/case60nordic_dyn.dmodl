	Iq_g60 = (-Xd_p_g60 * (Ed_p_g60 - V_60 * sin(δ_g60 - δ_60)) + Rs_g60 * (Eq_p_g60 - V_60 * cos(δ_g60 - δ_60))) / (Rs_g60^2 + Xd_p_g60 * Xq_p_g60)
	P_gml_60=lim(P_gmr_60, 0.1, 90.0)

	// Elec. power
	Pe_g38 = Ed_p_g38 * Id_g38 + Eq_p_g38 * Iq_g38 + (Xq_p_g38 - Xd_p_g38) * Id_g38 * Iq_g38
	Pe_g39 = Ed_p_g39 * Id_g39 + Eq_p_g39 * Iq_g39 + (Xq_p_g39 - Xd_p_g39) * Id_g39 * Iq_g39
	Pe_g40 = Ed_p_g40 * Id_g40 + Eq_p_g40 * Iq_g40 + (Xq_p_g40 - Xd_p_g40) * Id_g40 * Iq_g40
	Pe_g41 = Ed_p_g41 * Id_g41 + Eq_p_g41 * Iq_g41 + (Xq_p_g41 - Xd_p_g41) * Id_g41 * Iq_g41
	Pe_g42 = Ed_p_g42 * Id_g42 + Eq_p_g42 * Iq_g42 + (Xq_p_g42 - Xd_p_g42) * Id_g42 * Iq_g42
	Pe_g43 = Ed_p_g43 * Id_g43 + Eq_p_g43 * Iq_g43 + (Xq_p_g43 - Xd_p_g43) * Id_g43 * Iq_g43
