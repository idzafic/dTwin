	V_60 * (Id_g60*cos(δ_g60 - δ_60) - Iq_g60*sin(δ_g60 - δ_60)) =	-Y_60_60*V_60^2*sin(θ_60_60) + V_60 * (Y_60_13*V_13*sin(δ_60-θ_60_13-δ_13))

	// PF for PQ
	// node 1 - PQ
	Y_1_1*V_1^2*cos(θ_1_1) + V_1 * (Y_1_26*V_26*cos(δ_1-θ_1_26-δ_26) + Y_1_3*V_3*cos(δ_1-θ_1_3-δ_3)) = P_1
	-Y_1_1*V_1^2*sin(θ_1_1) + V_1 * (Y_1_26*V_26*sin(δ_1-θ_1_26-δ_26) + Y_1_3*V_3*sin(δ_1-θ_1_3-δ_3)) = Q_1
	// node 2 - PQ
	Y_2_2*V_2^2*cos(θ_2_2) + V_2 * (Y_2_38*V_38*cos(δ_2-θ_2_38-δ_38) + Y_2_23*V_23*cos(δ_2-θ_2_23-δ_23) + Y_2_24*V_24*cos(δ_2-θ_2_24-δ_24)) = P_2
	-Y_2_2*V_2^2*sin(θ_2_2) + V_2 * (Y_2_38*V_38*sin(δ_2-θ_2_38-δ_38) + Y_2_23*V_23*sin(δ_2-θ_2_23-δ_23) + Y_2_24*V_24*sin(δ_2-θ_2_24-δ_24)) = Q_2
