	Pe_g46 = Ed_p_g46 * Id_g46 + Eq_p_g46 * Iq_g46 + (Xq_p_g46 - Xd_p_g46) * Id_g46 * Iq_g46
	Pe_g47 = Ed_p_g47 * Id_g47 + Eq_p_g47 * Iq_g47 + (Xq_p_g47 - Xd_p_g47) * Id_g47 * Iq_g47
