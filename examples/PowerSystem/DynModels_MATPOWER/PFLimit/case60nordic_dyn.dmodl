	Pe_g54 = Ed_p_g54 * Id_g54 + Eq_p_g54 * Iq_g54 + (Xq_p_g54 - Xd_p_g54) * Id_g54 * Iq_g54
	Pe_g55 = Ed_p_g55 * Id_g55 + Eq_p_g55 * Iq_g55 + (Xq_p_g55 - Xd_p_g55) * Id_g55 * Iq_g55
	Pe_g56 = Ed_p_g56 * Id_g56 + Eq_p_g56 * Iq_g56 + (Xq_p_g56 - Xd_p_g56) * Id_g56 * Iq_g56
	Pe_g57 = Ed_p_g57 * Id_g57 + Eq_p_g57 * Iq_g57 + (Xq_p_g57 - Xd_p_g57) * Id_g57 * Iq_g57
	Pe_g58 = Ed_p_g58 * Id_g58 + Eq_p_g58 * Iq_g58 + (Xq_p_g58 - Xd_p_g58) * Id_g58 * Iq_g58
	Pe_g59 = Ed_p_g59 * Id_g59 + Eq_p_g59 * Iq_g59 + (Xq_p_g59 - Xd_p_g59) * Id_g59 * Iq_g59
	Pe_g60 = Ed_p_g60 * Id_g60 + Eq_p_g60 * Iq_g60 + (Xq_p_g60 - Xd_p_g60) * Id_g60 * Iq_g60

	// PF for PV
	// node 38 - PV
	V_38 * (Id_g38*sin(δ_g38 - δ_38) + Iq_g38*cos(δ_g38 - δ_38)) =	Y_38_38*V_38^2*cos(θ_38_38) + V_38 * (Y_38_2*V_2*cos(δ_38-θ_38_2-δ_2))
	V_38 * (Id_g38*cos(δ_g38 - δ_38) - Iq_g38*sin(δ_g38 - δ_38)) =	-Y_38_38*V_38^2*sin(θ_38_38) + V_38 * (Y_38_2*V_2*sin(δ_38-θ_38_2-δ_2))
	// node 39 - PV
	V_39 * (Id_g39*sin(δ_g39 - δ_39) + Iq_g39*cos(δ_g39 - δ_39)) =	Y_39_39*V_39^2*cos(θ_39_39) + V_39 * (Y_39_3*V_3*cos(δ_39-θ_39_3-δ_3))
	V_39 * (Id_g39*cos(δ_g39 - δ_39) - Iq_g39*sin(δ_g39 - δ_39)) =	-Y_39_39*V_39^2*sin(θ_39_39) + V_39 * (Y_39_3*V_3*sin(δ_39-θ_39_3-δ_3))
	// node 40 - PV
	V_40 * (Id_g40*sin(δ_g40 - δ_40) + Iq_g40*cos(δ_g40 - δ_40)) =	Y_40_40*V_40^2*cos(θ_40_40) + V_40 * (Y_40_24*V_24*cos(δ_40-θ_40_24-δ_24))
	V_40 * (Id_g40*cos(δ_g40 - δ_40) - Iq_g40*sin(δ_g40 - δ_40)) =	-Y_40_40*V_40^2*sin(θ_40_40) + V_40 * (Y_40_24*V_24*sin(δ_40-θ_40_24-δ_24))
	// node 41 - PV
	V_41 * (Id_g41*sin(δ_g41 - δ_41) + Iq_g41*cos(δ_g41 - δ_41)) =	Y_41_41*V_41^2*cos(θ_41_41) + V_41 * (Y_41_25*V_25*cos(δ_41-θ_41_25-δ_25))
	V_41 * (Id_g41*cos(δ_g41 - δ_41) - Iq_g41*sin(δ_g41 - δ_41)) =	-Y_41_41*V_41^2*sin(θ_41_41) + V_41 * (Y_41_25*V_25*sin(δ_41-θ_41_25-δ_25))
	// node 42 - PV
	V_42 * (Id_g42*sin(δ_g42 - δ_42) + Iq_g42*cos(δ_g42 - δ_42)) =	Y_42_42*V_42^2*cos(θ_42_42) + V_42 * (Y_42_4*V_4*cos(δ_42-θ_42_4-δ_4))
	V_42 * (Id_g42*cos(δ_g42 - δ_42) - Iq_g42*sin(δ_g42 - δ_42)) =	-Y_42_42*V_42^2*sin(θ_42_42) + V_42 * (Y_42_4*V_4*sin(δ_42-θ_42_4-δ_4))
	// node 43 - PV
	V_43 * (Id_g43*sin(δ_g43 - δ_43) + Iq_g43*cos(δ_g43 - δ_43)) =	Y_43_43*V_43^2*cos(θ_43_43) + V_43 * (Y_43_6*V_6*cos(δ_43-θ_43_6-δ_6))
	V_43 * (Id_g43*cos(δ_g43 - δ_43) - Iq_g43*sin(δ_g43 - δ_43)) =	-Y_43_43*V_43^2*sin(θ_43_43) + V_43 * (Y_43_6*V_6*sin(δ_43-θ_43_6-δ_6))
	// node 44 - PV
	V_44 * (Id_g44*sin(δ_g44 - δ_44) + Iq_g44*cos(δ_g44 - δ_44)) =	Y_44_44*V_44^2*cos(θ_44_44) + V_44 * (Y_44_7*V_7*cos(δ_44-θ_44_7-δ_7))
	V_44 * (Id_g44*cos(δ_g44 - δ_44) - Iq_g44*sin(δ_g44 - δ_44)) =	-Y_44_44*V_44^2*sin(θ_44_44) + V_44 * (Y_44_7*V_7*sin(δ_44-θ_44_7-δ_7))
	// node 45 - PV
	V_45 * (Id_g45*sin(δ_g45 - δ_45) + Iq_g45*cos(δ_g45 - δ_45)) =	Y_45_45*V_45^2*cos(θ_45_45) + V_45 * (Y_45_11*V_11*cos(δ_45-θ_45_11-δ_11))
	V_45 * (Id_g45*cos(δ_g45 - δ_45) - Iq_g45*sin(δ_g45 - δ_45)) =	-Y_45_45*V_45^2*sin(θ_45_45) + V_45 * (Y_45_11*V_11*sin(δ_45-θ_45_11-δ_11))
	// node 46 - PV
	V_46 * (Id_g46*sin(δ_g46 - δ_46) + Iq_g46*cos(δ_g46 - δ_46)) =	Y_46_46*V_46^2*cos(θ_46_46) + V_46 * (Y_46_26*V_26*cos(δ_46-θ_46_26-δ_26))
	V_46 * (Id_g46*cos(δ_g46 - δ_46) - Iq_g46*sin(δ_g46 - δ_46)) =	-Y_46_46*V_46^2*sin(θ_46_46) + V_46 * (Y_46_26*V_26*sin(δ_46-θ_46_26-δ_26))
	// node 47 - PV
	V_47 * (Id_g47*sin(δ_g47 - δ_47) + Iq_g47*cos(δ_g47 - δ_47)) =	Y_47_47*V_47^2*cos(θ_47_47) + V_47 * (Y_47_23*V_23*cos(δ_47-θ_47_23-δ_23))
	V_47 * (Id_g47*cos(δ_g47 - δ_47) - Iq_g47*sin(δ_g47 - δ_47)) =	-Y_47_47*V_47^2*sin(θ_47_47) + V_47 * (Y_47_23*V_23*sin(δ_47-θ_47_23-δ_23))
	// node 48 - PV
	V_48 * (Id_g48*sin(δ_g48 - δ_48) + Iq_g48*cos(δ_g48 - δ_48)) =	Y_48_48*V_48^2*cos(θ_48_48) + V_48 * (Y_48_27*V_27*cos(δ_48-θ_48_27-δ_27))
	V_48 * (Id_g48*cos(δ_g48 - δ_48) - Iq_g48*sin(δ_g48 - δ_48)) =	-Y_48_48*V_48^2*sin(θ_48_48) + V_48 * (Y_48_27*V_27*sin(δ_48-θ_48_27-δ_27))
	// node 49 - PV
	V_49 * (Id_g49*sin(δ_g49 - δ_49) + Iq_g49*cos(δ_g49 - δ_49)) =	Y_49_49*V_49^2*cos(θ_49_49) + V_49 * (Y_49_31*V_31*cos(δ_49-θ_49_31-δ_31))
	V_49 * (Id_g49*cos(δ_g49 - δ_49) - Iq_g49*sin(δ_g49 - δ_49)) =	-Y_49_49*V_49^2*sin(θ_49_49) + V_49 * (Y_49_31*V_31*sin(δ_49-θ_49_31-δ_31))
	// node 50 - PV
	V_50 * (Id_g50*sin(δ_g50 - δ_50) + Iq_g50*cos(δ_g50 - δ_50)) =	Y_50_50*V_50^2*cos(θ_50_50) + V_50 * (Y_50_14*V_14*cos(δ_50-θ_50_14-δ_14))
	V_50 * (Id_g50*cos(δ_g50 - δ_50) - Iq_g50*sin(δ_g50 - δ_50)) =	-Y_50_50*V_50^2*sin(θ_50_50) + V_50 * (Y_50_14*V_14*sin(δ_50-θ_50_14-δ_14))
	// node 51 - PV
	V_51 * (Id_g51*sin(δ_g51 - δ_51) + Iq_g51*cos(δ_g51 - δ_51)) =	Y_51_51*V_51^2*cos(θ_51_51) + V_51 * (Y_51_15*V_15*cos(δ_51-θ_51_15-δ_15))
	V_51 * (Id_g51*cos(δ_g51 - δ_51) - Iq_g51*sin(δ_g51 - δ_51)) =	-Y_51_51*V_51^2*sin(θ_51_51) + V_51 * (Y_51_15*V_15*sin(δ_51-θ_51_15-δ_15))
	// node 52 - PV
	V_52 * (Id_g52*sin(δ_g52 - δ_52) + Iq_g52*cos(δ_g52 - δ_52)) =	Y_52_52*V_52^2*cos(θ_52_52) + V_52 * (Y_52_18*V_18*cos(δ_52-θ_52_18-δ_18))
	V_52 * (Id_g52*cos(δ_g52 - δ_52) - Iq_g52*sin(δ_g52 - δ_52)) =	-Y_52_52*V_52^2*sin(θ_52_52) + V_52 * (Y_52_18*V_18*sin(δ_52-θ_52_18-δ_18))
	// node 53 - PV
	V_53 * (Id_g53*sin(δ_g53 - δ_53) + Iq_g53*cos(δ_g53 - δ_53)) =	Y_53_53*V_53^2*cos(θ_53_53) + V_53 * (Y_53_18*V_18*cos(δ_53-θ_53_18-δ_18))
	V_53 * (Id_g53*cos(δ_g53 - δ_53) - Iq_g53*sin(δ_g53 - δ_53)) =	-Y_53_53*V_53^2*sin(θ_53_53) + V_53 * (Y_53_18*V_18*sin(δ_53-θ_53_18-δ_18))
	// node 54 - PV
	V_54 * (Id_g54*sin(δ_g54 - δ_54) + Iq_g54*cos(δ_g54 - δ_54)) =	Y_54_54*V_54^2*cos(θ_54_54) + V_54 * (Y_54_19*V_19*cos(δ_54-θ_54_19-δ_19))
	V_54 * (Id_g54*cos(δ_g54 - δ_54) - Iq_g54*sin(δ_g54 - δ_54)) =	-Y_54_54*V_54^2*sin(θ_54_54) + V_54 * (Y_54_19*V_19*sin(δ_54-θ_54_19-δ_19))
	// node 55 - PV
	V_55 * (Id_g55*sin(δ_g55 - δ_55) + Iq_g55*cos(δ_g55 - δ_55)) =	Y_55_55*V_55^2*cos(θ_55_55) + V_55 * (Y_55_19*V_19*cos(δ_55-θ_55_19-δ_19))
	V_55 * (Id_g55*cos(δ_g55 - δ_55) - Iq_g55*sin(δ_g55 - δ_55)) =	-Y_55_55*V_55^2*sin(θ_55_55) + V_55 * (Y_55_19*V_19*sin(δ_55-θ_55_19-δ_19))
	// node 56 - PV
	V_56 * (Id_g56*sin(δ_g56 - δ_56) + Iq_g56*cos(δ_g56 - δ_56)) =	Y_56_56*V_56^2*cos(θ_56_56) + V_56 * (Y_56_21*V_21*cos(δ_56-θ_56_21-δ_21))
	V_56 * (Id_g56*cos(δ_g56 - δ_56) - Iq_g56*sin(δ_g56 - δ_56)) =	-Y_56_56*V_56^2*sin(θ_56_56) + V_56 * (Y_56_21*V_21*sin(δ_56-θ_56_21-δ_21))
	// node 57 - PV
	V_57 * (Id_g57*sin(δ_g57 - δ_57) + Iq_g57*cos(δ_g57 - δ_57)) =	Y_57_57*V_57^2*cos(θ_57_57) + V_57 * (Y_57_22*V_22*cos(δ_57-θ_57_22-δ_22))
	V_57 * (Id_g57*cos(δ_g57 - δ_57) - Iq_g57*sin(δ_g57 - δ_57)) =	-Y_57_57*V_57^2*sin(θ_57_57) + V_57 * (Y_57_22*V_22*sin(δ_57-θ_57_22-δ_22))
	// node 58 - PV
	V_58 * (Id_g58*sin(δ_g58 - δ_58) + Iq_g58*cos(δ_g58 - δ_58)) =	Y_58_58*V_58^2*cos(θ_58_58) + V_58 * (Y_58_22*V_22*cos(δ_58-θ_58_22-δ_22))
	V_58 * (Id_g58*cos(δ_g58 - δ_58) - Iq_g58*sin(δ_g58 - δ_58)) =	-Y_58_58*V_58^2*sin(θ_58_58) + V_58 * (Y_58_22*V_22*sin(δ_58-θ_58_22-δ_22))
	// node 59 - PV
	V_59 * (Id_g59*sin(δ_g59 - δ_59) + Iq_g59*cos(δ_g59 - δ_59)) =	Y_59_59*V_59^2*cos(θ_59_59) + V_59 * (Y_59_12*V_12*cos(δ_59-θ_59_12-δ_12))
	V_59 * (Id_g59*cos(δ_g59 - δ_59) - Iq_g59*sin(δ_g59 - δ_59)) =	-Y_59_59*V_59^2*sin(θ_59_59) + V_59 * (Y_59_12*V_12*sin(δ_59-θ_59_12-δ_12))
