	-Y_5_5*V_5^2*sin(θ_5_5) + V_5 * (Y_5_9*V_9*sin(δ_5-θ_5_9-δ_9) + Y_5_7*V_7*sin(δ_5-θ_5_7-δ_7)) = Q_5
	// node 6 - PQ
	Y_6_6*V_6^2*cos(θ_6_6) + V_6 * (Y_6_9*V_9*cos(δ_6-θ_6_9-δ_9) + Y_6_43*V_43*cos(δ_6-θ_6_43-δ_43) + Y_6_8*V_8*cos(δ_6-θ_6_8-δ_8)) = P_6
	-Y_6_6*V_6^2*sin(θ_6_6) + V_6 * (Y_6_9*V_9*sin(δ_6-θ_6_9-δ_9) + Y_6_43*V_43*sin(δ_6-θ_6_43-δ_43) + Y_6_8*V_8*sin(δ_6-θ_6_8-δ_8)) = Q_6
	// node 7 - PQ
	Y_7_7*V_7^2*cos(θ_7_7) + V_7 * (Y_7_44*V_44*cos(δ_7-θ_7_44-δ_44) + Y_7_5*V_5*cos(δ_7-θ_7_5-δ_5) + Y_7_8*V_8*cos(δ_7-θ_7_8-δ_8)) = P_7
	-Y_7_7*V_7^2*sin(θ_7_7) + V_7 * (Y_7_44*V_44*sin(δ_7-θ_7_44-δ_44) + Y_7_5*V_5*sin(δ_7-θ_7_5-δ_5) + Y_7_8*V_8*sin(δ_7-θ_7_8-δ_8)) = Q_7
	// node 8 - PQ
	Y_8_8*V_8^2*cos(θ_8_8) + V_8 * (Y_8_36*V_36*cos(δ_8-θ_8_36-δ_36) + Y_8_6*V_6*cos(δ_8-θ_8_6-δ_6) + Y_8_7*V_7*cos(δ_8-θ_8_7-δ_7)) = P_8
