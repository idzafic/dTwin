	Y_3_3*V_3^2*cos(θ_3_3) + V_3 * (Y_3_1*V_1*cos(δ_3-θ_3_1-δ_1) + Y_3_39*V_39*cos(δ_3-θ_3_39-δ_39) + Y_3_24*V_24*cos(δ_3-θ_3_24-δ_24)) = P_3
	-Y_3_3*V_3^2*sin(θ_3_3) + V_3 * (Y_3_1*V_1*sin(δ_3-θ_3_1-δ_1) + Y_3_39*V_39*sin(δ_3-θ_3_39-δ_39) + Y_3_24*V_24*sin(δ_3-θ_3_24-δ_24)) = Q_3
	// node 4 - PQ
	Y_4_4*V_4^2*cos(θ_4_4) + V_4 * (Y_4_25*V_25*cos(δ_4-θ_4_25-δ_25) + Y_4_42*V_42*cos(δ_4-θ_4_42-δ_42) + Y_4_28*V_28*cos(δ_4-θ_4_28-δ_28)) = P_4
	-Y_4_4*V_4^2*sin(θ_4_4) + V_4 * (Y_4_25*V_25*sin(δ_4-θ_4_25-δ_25) + Y_4_42*V_42*sin(δ_4-θ_4_42-δ_42) + Y_4_28*V_28*sin(δ_4-θ_4_28-δ_28)) = Q_4
